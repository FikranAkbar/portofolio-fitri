---
import ForceGraph from "./ForceGraph.tsx";
---

<!-- Main canvas area — flex:1, relative, no bg image -->
<section
  id="canvas-overlay"
  class="flex-1 h-full relative"
  style="background: #faf7f2; overflow: hidden;"
  aria-label="Interactive canvas"
>
  <div
    class="w-full h-full relative overflow-hidden"
    style="
      background-color: #faf7f2;
      background-image:
        linear-gradient(rgba(154,175,122,0.12) 1px, transparent 1px),
        linear-gradient(90deg, rgba(154,175,122,0.12) 1px, transparent 1px);
      background-size: 40px 40px;
    "
  >
    <ForceGraph client:load />
  </div>
  <!-- Drag hint -->
  <div style="position:absolute;bottom:16px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:10;">
    <span style="font-family:'Inter',system-ui,sans-serif;font-size:10px;color:#b0c890;letter-spacing:0.2em;text-transform:uppercase;font-weight:400;">
      drag to explore
    </span>
  </div>
</section>
