---
import ForceGraph from "./ForceGraph.tsx";
---

<!-- Canvas padding: 24px all sides (p-6) -->
<section
  id="canvas-overlay"
  class="flex-1 h-full relative p-6"
  style="background: transparent;"
  aria-label="Interactive canvas"
>
  <div
    class="w-full h-full relative overflow-hidden rounded-2xl"
    style="
      background-color: transparent;
      background-image:
        linear-gradient(rgba(180,168,148,0.18) 1px, transparent 1px),
        linear-gradient(90deg, rgba(180,168,148,0.18) 1px, transparent 1px);
      background-size: 40px 40px;
    "
  >
    <ForceGraph client:load />
  </div>
</section>
