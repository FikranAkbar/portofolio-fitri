---
import ForceGraph from './ForceGraph.tsx';
---

<!-- Canvas padding: 24px all sides (p-6) -->
<section
  class="flex-1 h-full relative bg-[#F5F5F5] p-6"
  aria-label="Interactive canvas"
>
  <div
    class="w-full h-full relative overflow-hidden rounded-2xl border border-gray-100/60"
    style="
      background-color: #F5F5F5;
      background-image:
        linear-gradient(45deg, #E8E8E8 25%, transparent 25%),
        linear-gradient(-45deg, #E8E8E8 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #E8E8E8 75%),
        linear-gradient(-45deg, transparent 75%, #E8E8E8 75%);
      background-size: 200px 200px;
      background-position: 0 0, 0 100px, 100px -100px, -100px 0px;
    "
  >
    <ForceGraph client:load />
  </div>
</section>
