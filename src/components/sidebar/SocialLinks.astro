---
import { Icon } from "astro-icon/components";

const links = [
  {
    label: "Email",
    href: "mailto:fitri@example.com",
    ionicon: null,
    customIcon: `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" class="shrink-0"><rect width="18.5" height="17" x="2.682" y="3.5" rx="4"/><path stroke-linecap="round" stroke-linejoin="round" d="m2.729 7.59l7.205 4.13a3.96 3.96 0 0 0 3.975 0l7.225-4.13"/></svg>`,
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com",
    ionicon: "ion:logo-linkedin",
    customIcon: null,
  },
  {
    label: "GitHub",
    href: "https://github.com",
    ionicon: "ion:logo-github",
    customIcon: null,
  },
  {
    label: "Instagram",
    href: "https://instagram.com",
    ionicon: "ion:logo-instagram",
    customIcon: null,
  },
];
---

<div style="margin-bottom: 16px;">
  <p
    style="
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #9aaf7a;
      margin-bottom: 6px;
      padding: 0 2px;
    "
  >
    Find Me At
  </p>
  <div style="display: flex; flex-direction: column; gap: 6px;">
    {
      links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          style="
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 400;
            color: #5a7040;
            text-decoration: none;
            transition: color 0.2s ease;
            padding: 2px 10px;
          "
        >
          {link.ionicon ? (
            <Icon
              name={link.ionicon}
              class="shrink-0"
              style="width: 14px; height: 14px; color: #9aaf7a;"
            />
          ) : (
            <span
              style="color: #9aaf7a; display: flex; align-items: center;"
              set:html={link.customIcon}
            />
          )}
          <span>{link.label}</span>
        </a>
      ))
    }
  </div>
</div>
