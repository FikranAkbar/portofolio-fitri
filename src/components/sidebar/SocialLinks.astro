---

<div>
  <p class="text-xs font-semibold tracking-widest uppercase mb-2" style="color:#6D6D6D">
    Find Me At
  </p>
  <div class="flex flex-col gap-1.5">
    {links.map(link => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-1.5 text-sm transition-colors duration-200"
        style="color:#6D6D6D"
      >
        <span class="transition-colors duration-200 [&>svg]:w-3.5 [&>svg]:h-3.5 group-hover:[&>svg]:stroke-[#FF49DB] group-hover:[&>svg]:fill-[#FF49DB]" style="color:#6D6D6D" set:html={link.icon} />
        <span class="group-hover:text-[#000000] transition-colors duration-200">{link.label}</span>
      </a>
    ))}
  </div>
</div>

