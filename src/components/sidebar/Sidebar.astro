---
import Avatar from './Avatar.astro';
import NavMenu from './NavMenu.astro';
import SocialLinks from './SocialLinks.astro';
import StatusWidget from './StatusWidget.tsx';
---

<!--
  Main menu card:  288px wide, full viewport height
  Inner padding:   24px left/right (px-6), 28px top/bottom (py-7)
  3 main components spaced 24px apart (gap-6):
    1. Logo
    2. Introduction
    3. Card Explore + Text Link
-->
<aside
  class="w-[288px] shrink-0 bg-white h-full flex flex-col overflow-y-auto scrollbar-hide rounded-2xl shadow-sm"
>
  <div class="flex flex-col flex-1 px-6 py-7 gap-6">

    <!-- ① Logo -->
    <div>
      <Avatar />
    </div>

    <!-- ② Introduction -->
    <div class="flex flex-col gap-2">
      <div>
        <h1 class="text-[32px] font-bold leading-tight text-gray-900 font-display tracking-tight">
          Fitri Zahwa
        </h1>
        <!-- Subtitle uses Space Mono — matches the monospace style in the design -->
        <p class="text-sm text-gray-400 font-normal mt-2 leading-snug font-mono">
          UI/UX Designer,<br />Illustrator, Pixel Artist
        </p>
      </div>
      <p class="text-base text-gray-500 leading-relaxed font-normal mt-1">
        I am a designer who loves building delightful software that solves real&nbsp;problems.
      </p>
    </div>

    <!-- ③ Card Explore + Text Link + Status -->
    <div class="flex flex-col gap-6 flex-1">
      <NavMenu />
      <div class="mt-auto flex flex-col gap-6">
        <SocialLinks />
        <StatusWidget client:load />
      </div>
    </div>

  </div>
</aside>
