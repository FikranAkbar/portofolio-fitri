---
import Avatar from "./Avatar.astro";
import NavMenu from "./NavMenu.astro";
import SocialLinks from "./SocialLinks.astro";
import StatusWidget from "./StatusWidget.tsx";
---

<aside class="sidebar">
  <!-- Scrollable area: profile + nav + social -->
  <div class="sidebar-scroll">
    <Avatar />

    <h1 class="sidebar-name">Fitri Zahwa</h1>
    <p class="sidebar-role">UI/UX Designer,<br />Illustrator, Pixel Artist</p>
    <p class="sidebar-bio">
      I am a designer who loves building delightful software that solves
      real&nbsp;problems.
    </p>

    <NavMenu />
    <SocialLinks />
  </div>

  <!-- Footer: always pinned at bottom -->
  <div class="sidebar-footer">
    <StatusWidget client:load />
  </div>
</aside>
