---
import Avatar from "./Avatar.astro";
import NavMenu from "./NavMenu.astro";
import SocialLinks from "./SocialLinks.astro";
import StatusWidget from "./StatusWidget.tsx";
---

<!--
  Sidebar — shared across all pages
  Width: 240px desktop / 220px tablet / full-width bottom bar mobile
-->
<aside
  class="sidebar shrink-0 h-full flex flex-col overflow-hidden"
  style="
    width: 240px;
    background: #ffffff;
    border-right: 0.5px solid rgba(154,175,122,0.25);
  "
>
  <!-- Scrollable section (everything except footer) -->
  <div
    class="sidebar-scroll flex-1 overflow-y-auto"
    style="padding: 20px 16px 0; scrollbar-width: none;"
  >
    <!-- Avatar -->
    <div style="margin-bottom: 12px;">
      <Avatar />
    </div>

    <!-- Name -->
    <h1
      style="
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 22px;
        font-weight: 700;
        color: #2d4a1e;
        line-height: 1.2;
        margin-bottom: 4px;
      "
    >
      Fitri Zahwa
    </h1>

    <!-- Role -->
    <p
      style="
        font-family: 'Inter', sans-serif;
        font-size: 10px;
        font-weight: 400;
        color: #6b8f4e;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 8px;
      "
    >
      UI/UX Designer · Illustrator · Pixel Artist
    </p>

    <!-- Bio -->
    <p
      style="
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 300;
        color: #5a7040;
        line-height: 1.6;
        margin-bottom: 20px;
      "
    >
      I am a designer who loves building delightful software that solves real&nbsp;problems.
    </p>

    <!-- Nav (EXPLORE) -->
    <div style="margin-bottom: 16px;">
      <NavMenu />
    </div>

    <!-- FIND ME AT -->
    <SocialLinks />
  </div>

  <!-- Footer — sticky bottom -->
  <div
    class="sidebar-footer shrink-0"
    style="
      padding: 12px 16px;
      border-top: 0.5px solid rgba(154,175,122,0.2);
      background: #ffffff;
    "
  >
    <StatusWidget client:load />
  </div>
</aside>
