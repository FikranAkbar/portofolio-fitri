---
import { Icon } from 'astro-icon/components';

const navItems = [
  { href: '#',           label: 'Home',            active: true,  external: false, projectTrigger: false },
  { href: '#',           label: 'Project',         active: false, external: false, projectTrigger: true  },
  { href: '#about',      label: 'About Me',        active: false, external: false, projectTrigger: false },
  { href: 'https://drive.google.com/file/d/1yl1f_f7vKW7DkzlGuwHA6h3F2KycF2JM/view?usp=drive_link', label: 'Resume', active: false, external: true, projectTrigger: false },
  { href: '#gallery',    label: 'Visitor Gallery', active: false, external: false, projectTrigger: false },
];
---

<!--
  Explore card: bg-gray-100, rounded-xl, 20px padding (p-5)
  Label → items gap: 8px (mb-2)
  Between items: 4px (gap-1)
  Arrows always visible
-->
<nav aria-label="Explore navigation">
  <div class="bg-gray-100 rounded-xl p-5">
    <p class="text-sm font-semibold tracking-widest uppercase mb-2" style="color:#6D6D6D">
      Explore
    </p>
    <div class="flex flex-col gap-1">
      {navItems.map(item => (
        <a
          href={item.projectTrigger ? 'javascript:void(0)' : item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          data-project-trigger={item.projectTrigger ? 'true' : undefined}
          class:list={[
            "group flex items-center justify-between px-2 py-1.5 rounded-lg text-base transition-all duration-200",
            item.active
              ? "bg-white shadow-sm font-medium"
              : "hover:bg-white hover:shadow-sm"
          ]}
          style={item.active ? "color:#000000" : "color:#6D6D6D"}
        >
          <span>{item.label}</span>
          <span
            class="transition-colors duration-200 flex items-center"
            style={item.active ? "color:#6D6D6D" : "color:#D1D5DB"}
            aria-hidden="true"
          >
            <Icon name="mage:arrow-right" class="w-3.5 h-3.5" />
          </span>
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  document.querySelectorAll('[data-project-trigger]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-project-page'));
    });
  });
</script>

