---
import { Icon } from "astro-icon/components";

const navItems = [
  {
    id: "home",
    href: "#",
    label: "Home",
    external: false,
    pageTrigger: null,
    icon: '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><path d="M9 21V12h6v9"/></svg>',
  },
  {
    id: "project",
    href: "#",
    label: "Project",
    external: false,
    pageTrigger: "project",
    icon: '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>',
  },
  {
    id: "about",
    href: "#",
    label: "About Me",
    external: false,
    pageTrigger: "about",
    icon: '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>',
  },
  {
    id: "resume",
    href: "https://drive.google.com/file/d/1yl1f_f7vKW7DkzlGuwHA6h3F2KycF2JM/view?usp=drive_link",
    label: "Resume",
    external: true,
    pageTrigger: null,
    icon: '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>',
  },
  {
    id: "gallery",
    href: "#",
    label: "Visitor Gallery",
    external: false,
    pageTrigger: "gallery",
    icon: '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg>',
  },
];
---

<nav aria-label="Explore navigation">
  <!-- Section label -->
  <p
    style="
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #9aaf7a;
      margin-bottom: 6px;
      padding: 0 2px;
    "
  >
    Explore
  </p>
  <div style="display: flex; flex-direction: column; gap: 2px;">
    {
      navItems.map((item) => (
        <a
          href={item.pageTrigger ? "javascript:void(0)" : item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
          data-nav-id={item.id}
          data-page-trigger={item.pageTrigger ?? undefined}
          class="nav-link"
          style="
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 7px 10px;
            border-radius: 8px;
            text-decoration: none;
            transition: background 0.15s ease;
            color: #5a7040;
          "
        >
          <span style="display: flex; align-items: center; gap: 8px;">
            <span
              class="nav-icon"
              style="display: flex; align-items: center; color: #9aaf7a; opacity: 0.7;"
              set:html={item.icon}
            />
            <span
              style="
                font-family: 'Inter', sans-serif;
                font-size: 14px;
                font-weight: 400;
              "
            >
              {item.label}
            </span>
          </span>
          <span
            class="nav-arrow"
            style="display: flex; align-items: center; color: #9aaf7a;"
            aria-hidden="true"
          >
            <Icon name="mage:arrow-right" class="w-3 h-3" />
          </span>
        </a>
      ))
    }
  </div>
</nav>

<script>
  function setActive(id: string) {
    document.querySelectorAll(".nav-link").forEach((link) => {
      const el = link as HTMLElement;
      const isActive = el.dataset.navId === id;
      el.dataset.active = isActive ? "true" : "false";
      if (isActive) {
        el.style.background = "rgba(200,219,160,0.35)";
        el.style.color = "#2d4a1e";
      } else {
        el.style.background = "";
        el.style.color = "#5a7040";
      }
      const arrow = el.querySelector(".nav-arrow") as HTMLElement | null;
      if (arrow) arrow.style.color = isActive ? "#6b8f4e" : "#9aaf7a";
      const icon = el.querySelector(".nav-icon") as HTMLElement | null;
      if (icon) {
        icon.style.opacity = isActive ? "1" : "0.7";
        icon.style.color = isActive ? "#6b8f4e" : "#9aaf7a";
      }
    });
  }

  // Map page id → nav id
  const PAGE_TO_NAV: Record<string, string> = {
    project: "project",
    about: "about",
    gallery: "gallery",
  };

  // Home is active on load
  setActive("home");

  // Hover states
  document.querySelectorAll(".nav-link").forEach((link) => {
    const el = link as HTMLElement;
    el.addEventListener("mouseenter", () => {
      if (el.dataset.active !== "true") {
        el.style.background = "rgba(200,219,160,0.15)";
      }
    });
    el.addEventListener("mouseleave", () => {
      if (el.dataset.active !== "true") {
        el.style.background = "";
      }
    });
  });

  // Page trigger clicks (project, about, gallery)
  document.querySelectorAll("[data-page-trigger]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      const page = (el as HTMLElement).dataset.pageTrigger!;
      window.dispatchEvent(new CustomEvent("open-page", { detail: { page } }));
    });
  });

  // Home → close any open page
  document
    .querySelector('[data-nav-id="home"]')
    ?.addEventListener("click", (e) => {
      e.preventDefault();
      setActive("home");
      window.dispatchEvent(new CustomEvent("navigate-home"));
    });

  // Sync nav active state when any page opens (from nav or force graph node)
  window.addEventListener("page-nav-update", (e) => {
    const page = (e as CustomEvent<{ page: string }>).detail.page;
    const navId = PAGE_TO_NAV[page];
    if (navId) setActive(navId);
  });

  // When any page closes via its X button
  window.addEventListener("page-closed", () => setActive("home"));

  // Backward compat
  window.addEventListener("open-project-page", () => setActive("project"));
  window.addEventListener("project-page-closed", () => setActive("home"));
</script>
