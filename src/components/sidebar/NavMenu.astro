---
import { Icon } from 'astro-icon/components';

const navItems = [
  { id: 'home',    href: '#',           label: 'Home',            external: false, pageTrigger: null      },
  { id: 'project', href: '#',           label: 'Project',         external: false, pageTrigger: 'project' },
  { id: 'about',   href: '#',           label: 'About Me',        external: false, pageTrigger: 'about'   },
  { id: 'resume',  href: 'https://drive.google.com/file/d/1yl1f_f7vKW7DkzlGuwHA6h3F2KycF2JM/view?usp=drive_link', label: 'Resume', external: true, pageTrigger: null },
  { id: 'gallery', href: '#',           label: 'Visitor Gallery', external: false, pageTrigger: 'gallery' },
];
---

<nav aria-label="Explore navigation">
  <div class="bg-gray-100 rounded-xl p-5">
    <p class="text-sm font-semibold tracking-widest uppercase mb-2" style="color:#6D6D6D">
      Explore
    </p>
    <div class="flex flex-col gap-1">
      {navItems.map(item => (
        <a
          href={item.pageTrigger ? 'javascript:void(0)' : item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          data-nav-id={item.id}
          data-page-trigger={item.pageTrigger ?? undefined}
          class="nav-link group flex items-center justify-between px-2 py-1.5 rounded-lg text-base transition-all duration-200 hover:bg-white hover:shadow-sm"
          style="color:#6D6D6D"
        >
          <span>{item.label}</span>
          <span
            class="nav-arrow transition-colors duration-200 flex items-center"
            style="color:#D1D5DB"
            aria-hidden="true"
          >
            <Icon name="mage:arrow-right" class="w-3.5 h-3.5" />
          </span>
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  function setActive(id: string) {
    document.querySelectorAll('.nav-link').forEach(link => {
      const el = link as HTMLElement;
      const isActive = el.dataset.navId === id;
      el.classList.toggle('bg-white',    isActive);
      el.classList.toggle('shadow-sm',   isActive);
      el.classList.toggle('font-medium', isActive);
      el.style.color = isActive ? '#000000' : '#6D6D6D';
      const arrow = el.querySelector('.nav-arrow') as HTMLElement | null;
      if (arrow) arrow.style.color = isActive ? '#6D6D6D' : '#D1D5DB';
    });
  }

  // Map page id → nav id
  const PAGE_TO_NAV: Record<string, string> = {
    project: 'project',
    about:   'about',
    gallery: 'gallery',
  };

  // Home is active on load
  setActive('home');

  // Page trigger clicks (project, about, gallery)
  document.querySelectorAll('[data-page-trigger]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const page = (el as HTMLElement).dataset.pageTrigger!;
      window.dispatchEvent(new CustomEvent('open-page', { detail: { page } }));
    });
  });

  // Home → close any open page
  document.querySelector('[data-nav-id="home"]')?.addEventListener('click', (e) => {
    e.preventDefault();
    setActive('home');
    window.dispatchEvent(new CustomEvent('navigate-home'));
  });

  // Sync nav active state when any page opens (from nav or force graph node)
  window.addEventListener('page-nav-update', (e) => {
    const page = (e as CustomEvent<{ page: string }>).detail.page;
    const navId = PAGE_TO_NAV[page];
    if (navId) setActive(navId);
  });

  // When any page closes via its X button
  window.addEventListener('page-closed', () => setActive('home'));

  // Backward compat
  window.addEventListener('open-project-page', () => setActive('project'));
  window.addEventListener('project-page-closed', () => setActive('home'));
</script>
