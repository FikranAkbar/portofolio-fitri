---
const navItems = [
  {
    id: "home",
    href: "#",
    label: "Home",
    external: false,
    pageTrigger: null,
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><path d="M9 21V12h6v9"/></svg>',
  },
  {
    id: "project",
    href: "#",
    label: "Project",
    external: false,
    pageTrigger: "project",
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>',
  },
  {
    id: "about",
    href: "#",
    label: "About Me",
    external: false,
    pageTrigger: "about",
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>',
  },
  {
    id: "resume",
    href: "https://drive.google.com/file/d/1yl1f_f7vKW7DkzlGuwHA6h3F2KycF2JM/view?usp=drive_link",
    label: "Resume",
    external: true,
    pageTrigger: null,
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>',
  },
  {
    id: "gallery",
    href: "#",
    label: "Visitor Gallery",
    external: false,
    pageTrigger: "gallery",
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg>',
  },
];
---

<nav aria-label="Explore navigation">
  <p class="sidebar-section-label">Explore</p>
  <ul class="sidebar-nav-list">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.external ? item.href : "javascript:void(0)"}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            data-nav-id={item.id}
            data-page-trigger={item.pageTrigger ?? undefined}
            class="sidebar-nav-item"
          >
            <span class="sidebar-nav-icon" set:html={item.icon} />
            <span>{item.label}</span>
            <span class="sidebar-nav-arrow" aria-hidden="true">
              ›
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  function setActive(id: string) {
    document.querySelectorAll(".sidebar-nav-item").forEach((link) => {
      const el = link as HTMLElement;
      const isActive = el.dataset.navId === id;
      if (isActive) {
        el.classList.add("active");
      } else {
        el.classList.remove("active");
      }
    });
  }

  const PAGE_TO_NAV: Record<string, string> = {
    project: "project",
    about: "about",
    gallery: "gallery",
  };

  setActive("home");

  document.querySelectorAll("[data-page-trigger]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      const page = (el as HTMLElement).dataset.pageTrigger!;
      window.dispatchEvent(new CustomEvent("open-page", { detail: { page } }));
    });
  });

  document
    .querySelector('[data-nav-id="home"]')
    ?.addEventListener("click", (e) => {
      e.preventDefault();
      setActive("home");
      window.dispatchEvent(new CustomEvent("navigate-home"));
    });

  window.addEventListener("page-nav-update", (e) => {
    const page = (e as CustomEvent<{ page: string }>).detail.page;
    const navId = PAGE_TO_NAV[page];
    if (navId) setActive(navId);
  });

  window.addEventListener("page-closed", () => setActive("home"));
  window.addEventListener("open-project-page", () => setActive("project"));
  window.addEventListener("project-page-closed", () => setActive("home"));
</script>
