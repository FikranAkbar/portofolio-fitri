---
import { Icon } from 'astro-icon/components';

const navItems = [
  { id: 'home',    href: '#',           label: 'Home',            external: false, projectTrigger: false },
  { id: 'project', href: '#',           label: 'Project',         external: false, projectTrigger: true  },
  { id: 'about',   href: '#about',      label: 'About Me',        external: false, projectTrigger: false },
  { id: 'resume',  href: 'https://drive.google.com/file/d/1yl1f_f7vKW7DkzlGuwHA6h3F2KycF2JM/view?usp=drive_link', label: 'Resume', external: true, projectTrigger: false },
  { id: 'gallery', href: '#gallery',    label: 'Visitor Gallery', external: false, projectTrigger: false },
];
---

<nav aria-label="Explore navigation">
  <div class="bg-gray-100 rounded-xl p-5">
    <p class="text-sm font-semibold tracking-widest uppercase mb-2" style="color:#6D6D6D">
      Explore
    </p>
    <div class="flex flex-col gap-1">
      {navItems.map(item => (
        <a
          href={item.projectTrigger ? 'javascript:void(0)' : item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          data-nav-id={item.id}
          data-project-trigger={item.projectTrigger ? 'true' : undefined}
          class="nav-link group flex items-center justify-between px-2 py-1.5 rounded-lg text-base transition-all duration-200 hover:bg-white hover:shadow-sm"
          style="color:#6D6D6D"
        >
          <span>{item.label}</span>
          <span
            class="nav-arrow transition-colors duration-200 flex items-center"
            style="color:#D1D5DB"
            aria-hidden="true"
          >
            <Icon name="mage:arrow-right" class="w-3.5 h-3.5" />
          </span>
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  function setActive(id: string) {
    document.querySelectorAll('.nav-link').forEach(link => {
      const el = link as HTMLElement;
      const isActive = el.dataset.navId === id;
      el.classList.toggle('bg-white',   isActive);
      el.classList.toggle('shadow-sm',  isActive);
      el.classList.toggle('font-medium', isActive);
      el.style.color = isActive ? '#000000' : '#6D6D6D';
      const arrow = el.querySelector('.nav-arrow') as HTMLElement | null;
      if (arrow) arrow.style.color = isActive ? '#6D6D6D' : '#D1D5DB';
    });
  }

  // Home is active on load
  setActive('home');

  // Project nav item click
  document.querySelector('[data-project-trigger]')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.dispatchEvent(new CustomEvent('open-project-page'));
  });

  // Home nav item click → close project page if open
  document.querySelector('[data-nav-id="home"]')?.addEventListener('click', (e) => {
    e.preventDefault();
    setActive('home');
    window.dispatchEvent(new CustomEvent('navigate-home'));
  });

  // When project page opens (from any source: nav or force graph node)
  window.addEventListener('open-project-page', () => setActive('project'));

  // When project page is closed (via its own close button)
  window.addEventListener('project-page-closed', () => setActive('home'));
</script>
