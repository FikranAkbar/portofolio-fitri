---
const navItems = [
  { href: '#',           label: 'Home',            active: true,  external: false },
  { href: '#projects',   label: 'Project',         active: false, external: false },
  { href: '#about',      label: 'About Me',        active: false, external: false },
  { href: 'https://drive.google.com/file/d/1yl1f_f7vKW7DkzlGuwHA6h3F2KycF2JM/view?usp=drive_link', label: 'Resume', active: false, external: true },
  { href: '#gallery',    label: 'Visitor Gallery', active: false, external: false },
];
---

<!--
  Explore card: bg-gray-100, rounded-xl, 20px padding (p-5)
  Label → items gap: 8px (mb-2)
  Between items: 4px (gap-1)
  Arrows always visible
-->
<nav aria-label="Explore navigation">
  <div class="bg-gray-100 rounded-xl p-5">
    <p class="text-sm font-semibold tracking-widest uppercase mb-2" style="color:#6D6D6D">
      Explore
    </p>
    <div class="flex flex-col gap-1">
      {navItems.map(item => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          class:list={[
            "group flex items-center justify-between px-2 py-1.5 rounded-lg text-base transition-all duration-200",
            item.active
              ? "bg-white shadow-sm font-medium"
              : "hover:bg-white hover:shadow-sm"
          ]}
          style={item.active ? "color:#000000" : "color:#6D6D6D"}
        >
          <span>{item.label}</span>
          <span
            class="transition-colors duration-200 flex items-center"
            style={item.active ? "color:#6D6D6D" : "color:#D1D5DB"}
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-miterlimit="10" d="M20 12H4"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="m12.968 19.66l6.572-6.572a1.53 1.53 0 0 0 0-2.176L12.968 4.34"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</nav>
