---
const navItems = [
  { href: '#',           label: 'Home',            active: true  },
  { href: '#projects',   label: 'Project',         active: false },
  { href: '#about',      label: 'About Me',        active: false },
  { href: '#resume',     label: 'Resume',          active: false },
  { href: '#gallery',    label: 'Visitor Gallery', active: false },
];
---

<nav aria-label="Explore navigation">
  <p class="text-base font-semibold tracking-widest text-gray-900 uppercase mb-3">
    Explore
  </p>
  <div class="flex flex-col gap-1">
    {navItems.map(item => (
      <a
        href={item.href}
        class:list={[
          "nav-item group flex items-center justify-between px-3 py-2.5 rounded-lg text-base transition-all duration-200",
          item.active
            ? "bg-gray-100 text-gray-900 font-medium"
            : "text-gray-500 hover:bg-gray-50 hover:text-gray-800"
        ]}
      >
        <span>{item.label}</span>
        <span class="arrow-icon text-gray-400" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</nav>
