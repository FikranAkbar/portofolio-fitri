---
// Avatar — 52px circle with botanical green border and online dot
---

<div style="position: relative; display: inline-block;">
  <div
    style="
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 2px solid #9aaf7a;
      background: #e8e2d8;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    "
  >
    <!-- Replace with <img> once a real photo is available -->
    <svg
      viewBox="0 0 24 24"
      fill="none"
      style="width: 28px; height: 28px; color: #9aaf7a;"
      aria-hidden="true"
    >
      <path
        d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"
        fill="currentColor"
      />
    </svg>
  </div>
  <!-- Online dot -->
  <span
    style="
      position: absolute;
      bottom: 2px;
      right: 2px;
      width: 10px;
      height: 10px;
      background: #6b8f4e;
      border-radius: 50%;
      border: 2px solid #ffffff;
      display: block;
    "
  ></span>
</div>

