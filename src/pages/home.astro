---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/sidebar/Sidebar.astro";
import CanvasPanel from "../components/canvas/CanvasPanel.astro";
---

<BaseLayout
  title="Fitri Zahwa — Portfolio"
  description="UI/UX Designer, Illustrator & Pixel Artist based in Indonesia"
>
  <!-- Guard: redirect to intro if not yet seen in this session -->
  <script>
    if (
      typeof sessionStorage !== "undefined" &&
      !sessionStorage.getItem("introSeen")
    ) {
      window.location.replace("/");
    }
  </script>

  <div
    class="flex h-screen w-full overflow-hidden"
    style="background: #faf7f2;"
  >
    <Sidebar />
    <CanvasPanel />
  </div>
</BaseLayout>
