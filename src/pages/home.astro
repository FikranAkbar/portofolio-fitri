---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/sidebar/Sidebar.astro";
import CanvasPanel from "../components/canvas/CanvasPanel.astro";
---

<BaseLayout
  title="Fitri Zahwa — Portfolio"
  description="UI/UX Designer, Illustrator & Pixel Artist based in Indonesia"
>
  <!-- Guard: redirect to intro if not yet seen in this session -->
  <script>
    if (
      typeof sessionStorage !== "undefined" &&
      !sessionStorage.getItem("introSeen")
    ) {
      window.location.replace("/");
    }
  </script>
  <!--
    Full-viewport two-column layout:
      left  → fixed-width sidebar (300px)
      right → flexible canvas panel
  -->
  <div
    class="flex h-screen w-full overflow-hidden"
    style="background-image: url('/images/main-bg.png'); background-size: cover; background-position: center; background-repeat: no-repeat;"
  >
    <!-- 24px spacing on left / top / bottom for the floating card -->
    <div class="pl-6 pt-6 pb-6 shrink-0 flex h-full">
      <Sidebar />
    </div>
    <CanvasPanel />
  </div>
</BaseLayout>
