                    opacity="0.55"
                    transform="rotate(216)"></path>
                  <path
                    d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z"
                    fill="#e06080"
                    opacity="0.55"
                    transform="rotate(288)"></path>
                  <!-- Inner spiral petals -->
                  <path
                    d="M0,1 C-4,0 -6,-6 -2,-9 C0,-10 2,-10 2,-9 C6,-6 4,0 0,1 Z"
                    fill="#d04868"
                    opacity="0.9"
                    transform="rotate(20)"></path>
                  <path
                    d="M0,1 C-4,0 -6,-6 -2,-9 C0,-10 2,-10 2,-9 C6,-6 4,0 0,1 Z"
                    fill="#d04868"
                    opacity="0.9"
                    transform="rotate(140)"></path>
                  <path
                    d="M0,1 C-4,0 -6,-6 -2,-9 C0,-10 2,-10 2,-9 C6,-6 4,0 0,1 Z"
                    fill="#d04868"
                    opacity="0.9"
                    transform="rotate(260)"></path>
                  <circle cx="0" cy="0" r="3.5" fill="#c03055"></circle>
                </g>
                <line
                  x1="24"
                  y1="40"
                  x2="24"
                  y2="28"
                  stroke="#4a7a30"
                  stroke-width="2"
                  stroke-linecap="round"></line>
                <path
                  d="M24 36 Q21 33 18 34"
                  stroke="#4a7a30"
                  stroke-width="1.3"
                  fill="none"
                  stroke-linecap="round"></path>
              </svg>
            </div>
            <span class="pick-name">Rose</span>
          </button>
        </div>
      </div>

      <!-- ── Plant button ── -->
      <div class="cta-section anim-5">
        <button class="btn-plant" id="btn-plant" disabled>
          Plant My Bloom
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path
              d="M4 7h7M8 4.5l3 2.5-3 2.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <p class="cta-fine-print">
          Your bloom will be part of this garden forever.
        </p>
      </div>
    </div><!-- end page-wrapper -->

    <script>
      import { supabase } from "../lib/supabase";

      // ── Already planted guard ─────────────────────────────────────
      const plantedData = localStorage.getItem("bloomPlanted");
      if (plantedData) {
        const overlay = document.getElementById("planted-overlay")!;
        overlay.style.display = "flex";
        try {
          const d = JSON.parse(plantedData);
          const nameEl2 = document.getElementById("planted-name-display")!;
          nameEl2.textContent = d.name
            ? `planted by ${d.name} · ${d.date}`
            : "";
        } catch (_) {}
        document
          .getElementById("planted-go-btn")!
          .addEventListener("click", () => navigateTo("/home"));
      }

      // ── Helpers ──────────────────────────────────────────────────
      function navigateTo(href: string) {
        sessionStorage.setItem("introSeen", "1");
        document.body.style.pointerEvents = "none";
        document.body.style.transition = "opacity 0.4s ease";
        document.body.style.opacity = "0";
        setTimeout(() => {
          window.location.href = href;
        }, 380);
      }

      // ── Date ─────────────────────────────────────────────────────
      const today = new Date();
      const dateStr = today.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      });
      (document.getElementById("input-date") as HTMLInputElement).value =
        dateStr;

      // ── Visitor number (simulated) ────────────────────────────────
      const baseCount = 1793;
      const sessionKey = "bloomVisitorNum";
      let visitorNum = parseInt(sessionStorage.getItem(sessionKey) || "0");
      if (!visitorNum) {
        visitorNum = baseCount + Math.floor(Math.random() * 20);
        sessionStorage.setItem(sessionKey, String(visitorNum));
      }
      document.getElementById("visitor-num")!.textContent = "No. " + visitorNum;

      // ── Char counter ─────────────────────────────────────────────
      const msgEl = document.getElementById(
        "input-message",
      ) as HTMLTextAreaElement;
      const cntEl = document.getElementById("char-left") as HTMLElement;
      msgEl.addEventListener("input", () => {
        cntEl.textContent = String(msgEl.value.length);
      });

      // ── Flower picker logic ───────────────────────────────────────
      let selectedFlower = "";

      // SVG source map for garden-field rendering
      const flowerSVGs: Record<string, string> = {
        sakura: `<svg viewBox="0 0 48 48" width="40" height="40" fill="none"><g transform="translate(24,24)"><path d="M0,0 Q-5,-2 -3,-10 L0,-13 L3,-10 Q5,-2 0,0 Z" fill="#e8a0bc" opacity="0.85" transform="rotate(0)"/><path d="M0,0 Q-5,-2 -3,-10 L0,-13 L3,-10 Q5,-2 0,0 Z" fill="#e8a0bc" opacity="0.85" transform="rotate(72)"/><path d="M0,0 Q-5,-2 -3,-10 L0,-13 L3,-10 Q5,-2 0,0 Z" fill="#e8a0bc" opacity="0.85" transform="rotate(144)"/><path d="M0,0 Q-5,-2 -3,-10 L0,-13 L3,-10 Q5,-2 0,0 Z" fill="#e8a0bc" opacity="0.85" transform="rotate(216)"/><path d="M0,0 Q-5,-2 -3,-10 L0,-13 L3,-10 Q5,-2 0,0 Z" fill="#e8a0bc" opacity="0.85" transform="rotate(288)"/><circle cx="0" cy="0" r="3.5" fill="#f9d0e0" opacity="0.95"/><circle cx="0" cy="0" r="1.5" fill="#e8a0bc" opacity="0.5"/></g></svg>`,
        lavender: `<svg viewBox="0 0 48 48" width="40" height="40" fill="none"><line x1="24" y1="44" x2="24" y2="12" stroke="#6a8f45" stroke-width="2" stroke-linecap="round"/><ellipse cx="24" cy="20" rx="3.5" ry="5" fill="#9b86d4" opacity="0.8"/><ellipse cx="24" cy="14" rx="3" ry="4.5" fill="#8b76c8" opacity="0.85"/><ellipse cx="24" cy="9" rx="2.5" ry="3.5" fill="#7b68c4" opacity="0.9"/></svg>`,
        daisy: `<svg viewBox="0 0 48 48" width="40" height="40" fill="none"><g transform="translate(24,20)"><ellipse cx="0" cy="-9" rx="3" ry="6.5" fill="white" opacity="0.9" transform="rotate(0)"/><ellipse cx="0" cy="-9" rx="3" ry="6.5" fill="white" opacity="0.9" transform="rotate(40)"/><ellipse cx="0" cy="-9" rx="3" ry="6.5" fill="white" opacity="0.9" transform="rotate(80)"/><ellipse cx="0" cy="-9" rx="3" ry="6.5" fill="white" opacity="0.9" transform="rotate(120)"/><ellipse cx="0" cy="-9" rx="3" ry="6.5" fill="white" opacity="0.9" transform="rotate(160)"/><ellipse cx="0" cy="-9" rx="3" ry="6.5" fill="white" opacity="0.9" transform="rotate(200)"/><ellipse cx="0" cy="-9" rx="3" ry="6.5" fill="white" opacity="0.9" transform="rotate(240)"/><ellipse cx="0" cy="-9" rx="3" ry="6.5" fill="white" opacity="0.9" transform="rotate(280)"/><ellipse cx="0" cy="-9" rx="3" ry="6.5" fill="white" opacity="0.9" transform="rotate(320)"/><circle cx="0" cy="0" r="5" fill="#f0c030" opacity="0.95"/><circle cx="0" cy="0" r="3" fill="#e6a820"/></g><line x1="24" y1="40" x2="24" y2="28" stroke="#6a8f45" stroke-width="2" stroke-linecap="round"/></svg>`,
        sunflower: `<svg viewBox="0 0 48 48" width="40" height="40" fill="none"><g transform="translate(24,18)"><ellipse cx="0" cy="-10" rx="3.5" ry="7" fill="#f0c030" opacity="0.88" transform="rotate(0)"/><ellipse cx="0" cy="-10" rx="3.5" ry="7" fill="#f0c030" opacity="0.88" transform="rotate(45)"/><ellipse cx="0" cy="-10" rx="3.5" ry="7" fill="#f0c030" opacity="0.88" transform="rotate(90)"/><ellipse cx="0" cy="-10" rx="3.5" ry="7" fill="#f0c030" opacity="0.88" transform="rotate(135)"/><ellipse cx="0" cy="-10" rx="3.5" ry="7" fill="#f0c030" opacity="0.88" transform="rotate(180)"/><ellipse cx="0" cy="-10" rx="3.5" ry="7" fill="#f0c030" opacity="0.88" transform="rotate(225)"/><ellipse cx="0" cy="-10" rx="3.5" ry="7" fill="#f0c030" opacity="0.88" transform="rotate(270)"/><ellipse cx="0" cy="-10" rx="3.5" ry="7" fill="#f0c030" opacity="0.88" transform="rotate(315)"/><circle cx="0" cy="0" r="6.5" fill="#7a4a10"/><circle cx="0" cy="0" r="4.5" fill="#5a3008"/></g><line x1="24" y1="42" x2="24" y2="24" stroke="#6a8f45" stroke-width="2.2" stroke-linecap="round"/></svg>`,
        babysbreath: `<svg viewBox="0 0 48 48" width="40" height="40" fill="none"><line x1="24" y1="42" x2="24" y2="28" stroke="#7a9a55" stroke-width="1.8" stroke-linecap="round"/><line x1="24" y1="32" x2="15" y2="22" stroke="#7a9a55" stroke-width="1.4" stroke-linecap="round"/><line x1="24" y1="30" x2="33" y2="20" stroke="#7a9a55" stroke-width="1.4" stroke-linecap="round"/><line x1="24" y1="28" x2="19" y2="16" stroke="#7a9a55" stroke-width="1.2" stroke-linecap="round"/><line x1="24" y1="28" x2="29" y2="14" stroke="#7a9a55" stroke-width="1.2" stroke-linecap="round"/><circle cx="15" cy="21" r="2.5" fill="white" stroke="#d0c8d8" stroke-width="0.8"/><circle cx="33" cy="19" r="2.5" fill="white" stroke="#d0c8d8" stroke-width="0.8"/><circle cx="19" cy="15" r="2" fill="white" stroke="#d0c8d8" stroke-width="0.8"/><circle cx="29" cy="13" r="2" fill="white" stroke="#d0c8d8" stroke-width="0.8"/><circle cx="24" cy="11" r="1.8" fill="white" stroke="#d0c8d8" stroke-width="0.8"/></svg>`,
        forgetmenot: `<svg viewBox="0 0 48 48" width="40" height="40" fill="none"><g transform="translate(16,22)"><circle cx="0" cy="-6" r="3.5" fill="#80aee0" opacity="0.85" transform="rotate(0)"/><circle cx="0" cy="-6" r="3.5" fill="#80aee0" opacity="0.85" transform="rotate(72)"/><circle cx="0" cy="-6" r="3.5" fill="#80aee0" opacity="0.85" transform="rotate(144)"/><circle cx="0" cy="-6" r="3.5" fill="#80aee0" opacity="0.85" transform="rotate(216)"/><circle cx="0" cy="-6" r="3.5" fill="#80aee0" opacity="0.85" transform="rotate(288)"/><circle cx="0" cy="0" r="2.2" fill="#fff7c0"/></g><g transform="translate(32,28)"><circle cx="0" cy="-5" r="2.8" fill="#6898d0" opacity="0.8" transform="rotate(0)"/><circle cx="0" cy="-5" r="2.8" fill="#6898d0" opacity="0.8" transform="rotate(72)"/><circle cx="0" cy="-5" r="2.8" fill="#6898d0" opacity="0.8" transform="rotate(144)"/><circle cx="0" cy="-5" r="2.8" fill="#6898d0" opacity="0.8" transform="rotate(216)"/><circle cx="0" cy="-5" r="2.8" fill="#6898d0" opacity="0.8" transform="rotate(288)"/><circle cx="0" cy="0" r="1.8" fill="#fff7c0"/></g><line x1="24" y1="42" x2="16" y2="32" stroke="#6a8f45" stroke-width="1.6" stroke-linecap="round"/><line x1="16" y1="32" x2="16" y2="24" stroke="#6a8f45" stroke-width="1.4" stroke-linecap="round"/><line x1="16" y1="30" x2="30" y2="26" stroke="#6a8f45" stroke-width="1.3" stroke-linecap="round"/></svg>`,
        cosmos: `<svg viewBox="0 0 48 48" width="40" height="40" fill="none"><g transform="translate(24,20)"><path d="M0,2 C-6,1 -10,-6 -5,-12 C-3,-15 3,-15 5,-12 C10,-6 6,1 0,2 Z" fill="#e090a8" opacity="0.8" transform="rotate(0)"/><path d="M0,2 C-6,1 -10,-6 -5,-12 C-3,-15 3,-15 5,-12 C10,-6 6,1 0,2 Z" fill="#e090a8" opacity="0.8" transform="rotate(45)"/><path d="M0,2 C-6,1 -10,-6 -5,-12 C-3,-15 3,-15 5,-12 C10,-6 6,1 0,2 Z" fill="#e090a8" opacity="0.8" transform="rotate(90)"/><path d="M0,2 C-6,1 -10,-6 -5,-12 C-3,-15 3,-15 5,-12 C10,-6 6,1 0,2 Z" fill="#e090a8" opacity="0.8" transform="rotate(135)"/><path d="M0,2 C-6,1 -10,-6 -5,-12 C-3,-15 3,-15 5,-12 C10,-6 6,1 0,2 Z" fill="#e090a8" opacity="0.8" transform="rotate(180)"/><path d="M0,2 C-6,1 -10,-6 -5,-12 C-3,-15 3,-15 5,-12 C10,-6 6,1 0,2 Z" fill="#e090a8" opacity="0.8" transform="rotate(225)"/><path d="M0,2 C-6,1 -10,-6 -5,-12 C-3,-15 3,-15 5,-12 C10,-6 6,1 0,2 Z" fill="#e090a8" opacity="0.8" transform="rotate(270)"/><path d="M0,2 C-6,1 -10,-6 -5,-12 C-3,-15 3,-15 5,-12 C10,-6 6,1 0,2 Z" fill="#e090a8" opacity="0.8" transform="rotate(315)"/><circle cx="0" cy="0" r="4" fill="#f0c038"/><circle cx="0" cy="0" r="2.5" fill="#e6a820"/></g><line x1="24" y1="40" x2="24" y2="26" stroke="#6a8f45" stroke-width="1.8" stroke-linecap="round"/></svg>`,
        rose: `<svg viewBox="0 0 48 48" width="40" height="40" fill="none"><g transform="translate(24,22)"><path d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z" fill="#e06080" opacity="0.55" transform="rotate(0)"/><path d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z" fill="#e06080" opacity="0.55" transform="rotate(72)"/><path d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z" fill="#e06080" opacity="0.55" transform="rotate(144)"/><path d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z" fill="#e06080" opacity="0.55" transform="rotate(216)"/><path d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z" fill="#e06080" opacity="0.55" transform="rotate(288)"/><path d="M0,1 C-4,0 -6,-6 -2,-9 C0,-10 2,-10 2,-9 C6,-6 4,0 0,1 Z" fill="#d04868" opacity="0.9" transform="rotate(20)"/><path d="M0,1 C-4,0 -6,-6 -2,-9 C0,-10 2,-10 2,-9 C6,-6 4,0 0,1 Z" fill="#d04868" opacity="0.9" transform="rotate(140)"/><path d="M0,1 C-4,0 -6,-6 -2,-9 C0,-10 2,-10 2,-9 C6,-6 4,0 0,1 Z" fill="#d04868" opacity="0.9" transform="rotate(260)"/><circle cx="0" cy="0" r="3.5" fill="#c03055"/></g><line x1="24" y1="40" x2="24" y2="28" stroke="#4a7a30" stroke-width="2" stroke-linecap="round"/></svg>`,
      };

      function createFlowerEl(
        svg: string,
        x: number,
        y: number,
        name: string,
        date: string,
        isNew = false,
      ): HTMLElement {
        const el = document.createElement("div");
        el.className = "garden-flower" + (isNew ? " new-flower" : "");
        el.style.left = x + "%";
        el.style.top = y + "%";
        const wrap = document.createElement("div");
        wrap.className = "flower-svg-wrap";
        // stagger float animation only for pre-existing flowers, not newly planted ones
        if (!isNew) {
          wrap.style.animationDelay = (Math.random() * 3).toFixed(2) + "s";
        }
        wrap.innerHTML = svg;
        el.appendChild(wrap);
        if (name) {
          const lbl = document.createElement("div");
          lbl.className = "flower-label";
          lbl.innerHTML = name + "<br/>" + date;
          el.appendChild(lbl);
          const tip = document.createElement("div");
          tip.className = "flower-tooltip";
          tip.innerHTML = "<strong>" + name + "</strong><br/>" + date;
          el.appendChild(tip);
        }
        return el;
      }

      // Fetch existing blooms from Supabase and render them in the garden
      const container = document.getElementById("flowers-container")!;

      supabase
        .from("blooms")
        .select("name, flower, date, x, y")
        .order("created_at", { ascending: true })
        .limit(50)
        .then(({ data }) => {
          if (!data) return;
          data.forEach((row) => {
            const svg = flowerSVGs[row.flower as string] ?? flowerSVGs.daisy;
            const el = createFlowerEl(
              svg,
              row.x as number,
              row.y as number,
              row.name as string,
              row.date as string,
              false,
            );
            container.appendChild(el);
          });
        });

      // ── Flower picker ──────────────────────────────────────────────
      const pickBtns =
        document.querySelectorAll<HTMLButtonElement>(".flower-pick-btn");
      const cursorFlower = document.getElementById("cursor-flower")!;
      const clickHint = document.getElementById("click-hint")!;
      const btnPlant = document.getElementById(
        "btn-plant",
      ) as HTMLButtonElement;
      const gardenField = document.getElementById(
        "garden-field",
      ) as HTMLElement;

      pickBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const f = btn.dataset.flower ?? "";
          if (selectedFlower === f) {
            // deselect
            selectedFlower = "";
            btn.classList.remove("active");
            cursorFlower.style.display = "none";
            clickHint.style.display = "none";
            gardenField.style.cursor = "crosshair";
            btnPlant.disabled = true;
          } else {
            pickBtns.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            selectedFlower = f;
            cursorFlower.innerHTML = flowerSVGs[f] ?? "";
            cursorFlower.style.display = "block";
            clickHint.style.display = "block";
            gardenField.style.cursor = "none";
            // enable plant button only when name is also filled
            updatePlantBtn();
          }
        });
      });

      // ── Name change → update button ──────────────────────────────
      const nameEl = document.getElementById("input-name") as HTMLInputElement;
      nameEl.addEventListener("input", updatePlantBtn);

      function updatePlantBtn() {
        btnPlant.disabled = !(selectedFlower && nameEl.value.trim().length > 0);
      }

      // ── Cursor follow inside garden ────────────────────────────────
      gardenField.addEventListener("mousemove", (e) => {
        if (!selectedFlower) return;
        cursorFlower.style.left = e.clientX + "px";
        cursorFlower.style.top = e.clientY + "px";
      });
      gardenField.addEventListener("mouseleave", () => {
        cursorFlower.style.display = "none";
      });
      gardenField.addEventListener("mouseenter", () => {
        if (selectedFlower) cursorFlower.style.display = "block";
      });

      // ── Click in garden → plant preview ──────────────────────────
      let pendingPosition: { x: number; y: number } | null = null;

      gardenField.addEventListener("click", (e) => {
        if (!selectedFlower) return;
        const rect = gardenField.getBoundingClientRect();
        const px = ((e.clientX - rect.left) / rect.width) * 100;
        const py = ((e.clientY - rect.top) / rect.height) * 100;

        // Remove previous preview
        document.querySelector(".garden-flower.preview")?.remove();

        // Add flower preview
        const svg = flowerSVGs[selectedFlower] ?? "";
        const el = createFlowerEl(svg, px, py, "", "", true);
        el.classList.add("preview");
        gardenField.appendChild(el);

        pendingPosition = { x: px, y: py };

        // Enable plant if name is filled
        updatePlantBtn();
      });

      // ── Plant My Bloom ────────────────────────────────────────────
      btnPlant.addEventListener("click", async () => {
        const name = nameEl.value.trim();
        if (!name || !selectedFlower) return;

        // Prevent double-submit
        btnPlant.disabled = true;

        // If they didn't click the garden, plant at a random nice spot
        if (!pendingPosition) {
          pendingPosition = {
            x: 20 + Math.random() * 60,
            y: 20 + Math.random() * 60,
          };
          const svg = flowerSVGs[selectedFlower] ?? "";
          const el = createFlowerEl(
            svg,
            pendingPosition.x,
            pendingPosition.y,
            "",
            "",
            true,
          );
          el.classList.add("preview");
          gardenField.appendChild(el);
        }

        const bloomEntry = {
          name,
          flower: selectedFlower,
          message: (
            document.getElementById("input-message") as HTMLTextAreaElement
          ).value.trim(),
          date: dateStr,
          visitor_num: String(visitorNum),
          x: pendingPosition.x,
          y: pendingPosition.y,
        };

        // Save to Supabase (shared across all visitors)
        const { error } = await supabase.from("blooms").insert(bloomEntry);
        if (error) console.warn("Supabase insert failed:", error.message);

        // Mark this browser as having already planted
        localStorage.setItem(
          "bloomPlanted",
          JSON.stringify({ name, date: dateStr }),
        );

        // Keep sessionStorage so home page can reference "your flower"
        sessionStorage.setItem("bloomData", JSON.stringify(bloomEntry));

        navigateTo("/home");
      });

      // ── Skip ─────────────────────────────────────────────────────
      document.getElementById("btn-skip")?.addEventListener("click", () => {
        navigateTo("/home");
      });
    </script>
  </body>
</html>
