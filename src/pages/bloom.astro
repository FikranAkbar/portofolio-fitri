---

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Leave Your Bloom — Fitri's Garden</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@300;400;500;600&family=DM+Sans:ital,wght@0,400;0,500;1,400&family=Source+Code+Pro:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        /* restore normal cursor — overrides global.css cursor:none */
        cursor: auto !important;
      }
      button,
      a,
      [role="button"] {
        cursor: pointer !important;
      }
      html,
      body {
        height: 100%;
        overflow: hidden;
        font-family: "Inter", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        background: #faf7f2;
      }

      /* ─── Transition curtain (simple fade) ─── */
      #transition-curtain {
        position: fixed;
        inset: 0;
        z-index: 9998;
        background: #faf7f2;
        pointer-events: none;
        animation: curtain-fade-out 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.05s
          forwards;
      }
      @keyframes curtain-fade-out {
        0% {
          opacity: 1;
        }
        20% {
          opacity: 0.92;
        }
        100% {
          opacity: 0;
          visibility: hidden;
        }
      }

      /* ─── Page fade-in ─── */
      @keyframes fade-up {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes fade-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes bloom-pop {
        0% {
          transform: scale(0) rotate(-15deg);
          opacity: 0;
        }
        60% {
          transform: scale(1.18) rotate(4deg);
          opacity: 1;
        }
        100% {
          transform: scale(1) rotate(0deg);
          opacity: 1;
        }
      }

      @keyframes gentle-float {
        0%,
        100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-4px);
        }
      }
      @keyframes page-exit {
        from {
          opacity: 1;
        }
        to {
          opacity: 0;
        }
      }
      .page-fade-in {
        animation: fade-in 0.55s ease both;
      }
      .anim-1 {
        animation: fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.05s both;
      }
      .anim-2 {
        animation: fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
      }
      .anim-3 {
        /* opacity-only — NO translateY so getBoundingClientRect() is accurate during animation */
        animation: fade-in 0.7s ease 0.2s both;
      }
      .anim-4 {
        animation: fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.38s both;
      }
      .anim-5 {
        animation: fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both;
      }

      /* ─── Layout shell ─── */
      .page-wrapper {
        height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: transparent;
        position: relative;
      }

      /* Soft warm background blobs */
      .bg-blob {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
      }

      /* ─── Top bar ─── */
      .top-bar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 16px 28px 0;
        position: relative;
        z-index: 10;
        flex-shrink: 0;
      }
      .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: "Inter", system-ui, sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(30, 58, 28, 0.5);
        background: transparent;
        border: none;
        transition: color 0.2s ease;
        text-decoration: none;
        padding: 4px 0;
      }
      .btn-back:hover {
        color: rgba(30, 58, 28, 0.88);
      }

      .skip-block {
        text-align: right;
      }
      .btn-skip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 18px;
        border: 1.5px solid rgba(60, 90, 55, 0.3);
        border-radius: 100px;
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(8px);
        color: rgba(30, 58, 28, 0.72);
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        transition: all 0.2s ease;
        cursor: pointer;
      }
      .btn-skip:hover {
        border-color: rgba(60, 90, 55, 0.55);
        color: rgba(30, 58, 28, 1);
        background: rgba(255, 255, 255, 0.8);
      }
      .skip-hint {
        margin-top: 4px;
        font-family: "Inter", sans-serif;
        font-size: 10px;
        font-style: italic;
        color: rgba(30, 58, 28, 0.38);
        line-height: 1.4;
      }

      /* ─── Hero ─── */
      .hero {
        text-align: center;
        padding: 8px 24px 6px;
        position: relative;
        z-index: 10;
        flex-shrink: 0;
      }
      .hero-welcome {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: rgba(30, 58, 28, 0.45);
        margin-bottom: 4px;
      }
      .hero-title {
        font-family: "Playfair Display", Georgia, serif;
        font-size: clamp(26px, 3.2vw, 40px);
        font-weight: 700;
        color: #1a3518;
        line-height: 1.08;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
      }
      .hero-title .deco {
        font-size: clamp(14px, 1.6vw, 20px);
        opacity: 0.62;
        display: inline-block;
      }
      .hero-subtitle {
        font-family: "Inter", sans-serif;
        font-size: clamp(11px, 1vw, 13px);
        font-weight: 400;
        color: rgba(30, 58, 28, 0.55);
        line-height: 1.5;
      }

      /* ─── Main content area ─── */
      .main-area {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 14px;
        padding: 0 20px;
        position: relative;
        z-index: 10;
        overflow: hidden;
      }

      /* ─── Garden Field ─── */
      .garden-field {
        background:
          radial-gradient(
            circle at 1px 1px,
            rgba(100, 80, 50, 0.045) 1px,
            transparent 0
          ),
          linear-gradient(160deg, #f7f2e6 0%, #ede7d5 50%, #e8e0cc 100%);
        background-size:
          22px 22px,
          auto;
        border: 1.5px solid rgba(130, 110, 70, 0.15);
        border-radius: 16px;
        box-shadow:
          0 4px 24px rgba(80, 60, 30, 0.08),
          inset 0 1px 0 rgba(255, 255, 255, 0.6);
        position: relative;
        overflow: hidden;
        cursor: crosshair;
        height: 100%;
      }
      /* Parchment inner border */
      .garden-field::before {
        content: "";
        position: absolute;
        inset: 10px;
        border: 1px solid rgba(130, 110, 70, 0.09);
        border-radius: 12px;
        pointer-events: none;
        z-index: 1;
      }

      /* Garden info card (top-left) */
      .garden-info-card {
        position: absolute;
        top: 18px;
        left: 18px;
        background: rgba(255, 252, 244, 0.88);
        border: 1px solid rgba(130, 110, 70, 0.14);
        border-radius: 12px;
        padding: 11px 14px;
        font-family: "Inter", sans-serif;
        font-size: 12px;
        color: rgba(60, 45, 20, 0.65);
        line-height: 1.6;
        max-width: 180px;
        backdrop-filter: blur(4px);
        box-shadow: 0 2px 10px rgba(80, 60, 30, 0.07);
        z-index: 5;
        pointer-events: none;
      }

      /* Click hint (center-right) */
      .garden-click-hint {
        position: absolute;
        right: 24px;
        bottom: 60px;
        background: rgba(255, 252, 244, 0.9);
        border: 1px solid rgba(130, 110, 70, 0.16);
        border-radius: 12px;
        padding: 10px 14px;
        font-family: "Inter", sans-serif;
        font-size: 12px;
        color: rgba(60, 45, 20, 0.6);
        line-height: 1.55;
        text-align: center;
        pointer-events: none;
        z-index: 5;
        backdrop-filter: blur(4px);
        box-shadow: 0 2px 8px rgba(80, 60, 30, 0.06);
        display: none; /* shown after flower selection */
      }

      /* Drag hint (bottom-left) */
      .garden-drag-hint {
        position: absolute;
        left: 18px;
        bottom: 16px;
        display: flex;
        align-items: center;
        gap: 7px;
        font-family: "Inter", sans-serif;
        font-size: 10px;
        font-weight: 400;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #b0c890;
        z-index: 5;
        pointer-events: none;
      }
      .garden-drag-hint svg {
        opacity: 0.5;
        flex-shrink: 0;
      }

      /* ─── Flowers in garden ─── */
      .garden-flower {
        position: absolute;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        transform: translate(-50%, -50%);
        z-index: 3;
        cursor: default;
      }
      .garden-flower .flower-svg-wrap {
        width: 56px;
        height: 56px;
        min-width: 56px;
        min-height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
        transition: transform 0.2s ease;
        animation: gentle-float 4s ease-in-out infinite;
      }
      .garden-flower .flower-svg-wrap svg {
        width: 56px !important;
        height: 56px !important;
        flex-shrink: 0;
      }
      .garden-flower:hover .flower-svg-wrap {
        transform: scale(1.12);
      }
      .garden-flower.new-flower .flower-svg-wrap {
        animation:
          bloom-pop 0.55s cubic-bezier(0.22, 1, 0.36, 1) both,
          gentle-float 4s ease-in-out 0.55s infinite;
      }

      /* visitor label under flower */
      .garden-flower .flower-label {
        font-family: "Inter", sans-serif;
        font-size: 10px;
        font-weight: 500;
        color: rgba(50, 35, 15, 0.65);
        text-align: center;
        line-height: 1.4;
        white-space: nowrap;
        pointer-events: none;
      }

      /* Tooltip on hover */
      .garden-flower .flower-tooltip {
        position: absolute;
        bottom: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%);
        background: rgba(255, 252, 244, 0.97);
        border: 1px solid rgba(130, 110, 70, 0.18);
        border-radius: 10px;
        padding: 8px 12px;
        font-family: "Inter", sans-serif;
        font-size: 12px;
        color: rgba(50, 35, 15, 0.75);
        white-space: nowrap;
        box-shadow: 0 4px 14px rgba(80, 60, 30, 0.1);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.18s ease;
        z-index: 20;
      }
      .garden-flower:hover .flower-tooltip {
        opacity: 1;
      }

      /* Cursor preview flower */
      #cursor-flower {
        position: fixed;
        pointer-events: none;
        transform: translate(-50%, -50%);
        z-index: 100;
        opacity: 0.55;
        width: 56px;
        height: 56px;
        display: none;
      }

      /* ─── Form Panel ─── */
      .form-panel {
        background: #f5f0e8;
        border: 1.5px solid rgba(154, 175, 122, 0.3);
        border-radius: 16px;
        padding: 16px 16px 14px;
        box-shadow:
          0 4px 24px rgba(60, 90, 50, 0.08),
          inset 0 1px 0 rgba(255, 255, 255, 0.6);
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow-y: auto;
        height: 100%;
      }

      .form-panel-title {
        text-align: center;
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: rgba(30, 55, 25, 0.65);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }
      .form-panel-title .deco-arrow {
        font-size: 12px;
        opacity: 0.5;
      }

      .form-divider {
        height: 1px;
        background: rgba(80, 115, 65, 0.14);
        margin: -4px 0;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .form-label {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(30, 55, 25, 0.55);
      }
      .form-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.72);
        border: 1.5px solid rgba(100, 130, 90, 0.2);
        border-radius: 10px;
        padding: 8px 12px;
        font-family: "Inter", sans-serif;
        font-size: 12px;
        color: #1e3a1c;
        outline: none;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease;
        -webkit-appearance: none;
      }
      .form-input:focus {
        border-color: rgba(80, 120, 65, 0.55);
        box-shadow: 0 0 0 3px rgba(80, 120, 65, 0.1);
      }
      .form-input::placeholder {
        color: rgba(50, 80, 40, 0.35);
        font-style: italic;
      }
      .form-input[readonly] {
        background: rgba(255, 255, 255, 0.5);
        cursor: default;
        color: rgba(30, 58, 28, 0.75);
      }

      .date-input-wrap {
        position: relative;
      }
      .date-input-wrap .date-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(80, 120, 65, 0.45);
        pointer-events: none;
      }

      .form-textarea {
        width: 100%;
        background: rgba(255, 255, 255, 0.72);
        border: 1.5px solid rgba(100, 130, 90, 0.2);
        border-radius: 10px;
        padding: 8px 12px;
        font-family: "Inter", sans-serif;
        font-size: 12px;
        font-style: italic;
        color: #1e3a1c;
        outline: none;
        resize: none;
        min-height: 64px;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease;
        line-height: 1.5;
      }
      .form-textarea:focus {
        border-color: rgba(80, 120, 65, 0.55);
        box-shadow: 0 0 0 3px rgba(80, 120, 65, 0.1);
      }
      .form-textarea::placeholder {
        color: rgba(50, 80, 40, 0.35);
      }
      .char-count {
        text-align: right;
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        color: rgba(50, 80, 40, 0.4);
        letter-spacing: 0.08em;
        margin-top: -10px;
      }

      /* Visitor number */
      .visitor-block {
        text-align: center;
        padding: 8px 8px 6px;
        border-top: 1px solid rgba(80, 115, 65, 0.14);
        margin-top: auto;
      }
      .visitor-label {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: rgba(30, 55, 25, 0.48);
        margin-bottom: 2px;
      }
      .visitor-number {
        font-family: "Playfair Display", Georgia, serif;
        font-size: 24px;
        font-weight: 700;
        color: #1a3518;
        line-height: 1.1;
        margin-bottom: 3px;
      }
      .visitor-thanks {
        font-family: "Inter", sans-serif;
        font-size: 10px;
        font-style: italic;
        color: rgba(30, 55, 25, 0.45);
      }
      .visitor-dot {
        display: block;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: rgba(80, 120, 65, 0.45);
        margin: 4px auto 0;
      }

      /* ─── Flower Picker ─── */
      .picker-section {
        padding: 8px 20px 6px;
        position: relative;
        z-index: 10;
        flex-shrink: 0;
      }
      .picker-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: rgba(30, 58, 28, 0.42);
        margin-bottom: 7px;
      }
      .picker-label::before,
      .picker-label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: rgba(80, 100, 65, 0.14);
        max-width: 80px;
      }

      .picker-row {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 7px;
        flex-wrap: nowrap;
      }

      .flower-pick-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        background: rgba(255, 252, 244, 0.72);
        border: 1.5px solid rgba(130, 110, 70, 0.18);
        border-radius: 14px;
        padding: 8px 8px 6px;
        width: 70px;
        cursor: pointer;
        transition: all 0.2s ease;
        backdrop-filter: blur(4px);
        flex-shrink: 0;
      }
      .flower-pick-btn:hover {
        background: rgba(255, 252, 244, 0.95);
        transform: translateY(-3px);
        box-shadow: 0 6px 18px rgba(80, 60, 30, 0.1);
      }
      .flower-pick-btn.active {
        border-color: var(--flower-color, rgba(180, 100, 120, 0.6));
        background: rgba(255, 252, 244, 0.97);
        box-shadow: 0 0 0 3px rgba(var(--flower-color-rgb, 180, 100, 120), 0.15);
        transform: translateY(-3px);
      }
      .flower-pick-btn .pick-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      .flower-pick-btn .pick-icon svg {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
      }
      .flower-pick-btn .pick-name {
        font-family: "Inter", sans-serif;
        font-size: 10px;
        font-weight: 500;
        color: rgba(50, 35, 15, 0.6);
        text-align: center;
        transition: color 0.2s ease;
      }
      .flower-pick-btn.active .pick-name {
        color: var(--flower-color, rgba(180, 100, 120, 0.9));
        font-weight: 600;
      }

      /* ─── Bottom CTA ─── */
      .cta-section {
        padding: 6px 28px 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        position: relative;
        z-index: 10;
        flex-shrink: 0;
      }
      .btn-plant {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 11px 44px;
        background: transparent;
        color: #4a6741;
        border: 1.5px solid #9aaf7a;
        border-radius: 100px;
        font-family: "Inter", system-ui, sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.08em;
        cursor: pointer;
        transition: all 0.25s ease;
      }
      .btn-plant:hover {
        background: #9aaf7a;
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 6px 22px rgba(154, 175, 122, 0.32);
      }
      .btn-plant:active {
        transform: translateY(0);
      }
      .btn-plant:disabled {
        opacity: 0.45;
        cursor: default;
        transform: none;
        box-shadow: none;
      }
      .cta-fine-print {
        font-family: "Inter", sans-serif;
        font-size: 12px;
        font-style: italic;
        color: rgba(30, 58, 28, 0.35);
      }

      /* ─── Already planted state ─── */
      .planted-overlay {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 18px;
        background: rgba(247, 243, 234, 0.97);
        backdrop-filter: blur(6px);
      }
      .planted-card {
        background: rgba(255, 252, 244, 0.98);
        border: 1.5px solid rgba(130, 110, 70, 0.18);
        border-radius: 20px;
        padding: 36px 44px;
        text-align: center;
        box-shadow: 0 8px 32px rgba(80, 60, 30, 0.1);
        max-width: 380px;
      }
      .planted-icon {
        font-size: 48px;
        margin-bottom: 12px;
      }
      .planted-title {
        font-family: "Playfair Display", Georgia, serif;
        font-size: 22px;
        font-weight: 700;
        color: #1a3518;
        margin-bottom: 8px;
      }
      .planted-sub {
        font-family: "Inter", sans-serif;
        font-size: 14px;
        color: rgba(30, 58, 28, 0.6);
        line-height: 1.6;
        margin-bottom: 20px;
      }
      .planted-name {
        font-family: "Playfair Display", Georgia, serif;
        font-size: 16px;
        font-style: italic;
        color: rgba(30, 58, 28, 0.55);
        margin-bottom: 24px;
      }
      .planted-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 32px;
        background: transparent;
        color: #4a6741;
        border: 1.5px solid #9aaf7a;
        border-radius: 100px;
        font-family: "Inter", system-ui, sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.08em;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .planted-btn:hover {
        background: #9aaf7a;
        color: #fff;
        transform: translateY(-1px);
      }

      /* ─── Responsive ─── */
      @media (max-width: 820px) {
        .main-area {
          grid-template-columns: 1fr;
          padding: 0 12px;
          overflow-y: auto;
        }
        .form-panel {
          order: 2;
          height: auto;
        }
        .garden-field {
          height: 260px;
          order: 1;
        }
        .page-wrapper {
          height: auto;
          min-height: 100vh;
          overflow-y: auto;
        }
        html,
        body {
          overflow: auto;
        }
        .top-bar {
          padding: 14px 16px 0;
        }
        .picker-section {
          padding: 8px 12px 6px;
        }
        .cta-section {
          padding: 6px 16px 20px;
        }
        .picker-row {
          gap: 5px;
          flex-wrap: wrap;
        }
        .flower-pick-btn {
          width: 62px;
          padding: 7px 6px 5px;
        }
