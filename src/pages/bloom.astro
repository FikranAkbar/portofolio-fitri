  <body>
    <!-- Already-planted overlay (hidden by default, shown by JS) -->
    <div id="planted-overlay" class="planted-overlay" style="display:none;">
      <div class="planted-card">
        <div class="planted-icon">🌸</div>
        <p class="planted-title">Your bloom is already here.</p>
        <p class="planted-sub">
          You've already planted your flower in the garden.<br />Every visitor
          can only leave one bloom.
        </p>
        <p class="planted-name" id="planted-name-display"></p>
        <button class="planted-btn" id="planted-go-btn">
          Go to the garden
          <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
            <path
              d="M4 6.5h6M7.5 4l3 2.5-3 2.5"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Crossfade curtain: overlays garden-bg and fades out to reveal bloom-bg -->
    <div id="transition-curtain" aria-hidden="true"></div>

    <!-- Cursor flower preview -->
    <div id="cursor-flower"></div>

    <div class="page-wrapper page-fade-in">
      <!-- ── Top bar ── -->
      <div class="top-bar">
        <a href="/" class="btn-back anim-1">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path
              d="M9 7H3M5 4l-3 3 3 3"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Back
        </a>
        <div class="skip-block anim-1">
          <button class="btn-skip" id="btn-skip">
            Skip This Step
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <path
                d="M4 6.5h6M7.5 4l3 2.5-3 2.5"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <p class="skip-hint">
            You can explore first<br />and come back anytime!
          </p>
        </div>
      </div>

      <!-- ── Hero ── -->
      <div class="hero anim-2">
        <p class="hero-welcome">Welcome, Visitor.</p>
        <h1 class="hero-title">
          <span class="deco">❧</span>
          Leave Your Bloom
          <span class="deco">❧</span>
        </h1>
        <p class="hero-subtitle">
          Plant a flower anywhere in the garden<br />and leave a little piece of
          you here.
        </p>
      </div>

      <!-- ── Main: garden + form ── -->
      <div class="main-area anim-3">
        <!-- Garden Field -->
        <div class="garden-field" id="garden-field">
          <!-- Info card -->
          <div class="garden-info-card">
            This is our growing garden.<br />
            Every bloom here was planted<br />
            by someone who visited.
          </div>

          <!-- Click hint (shown after flower selected) -->
          <div class="garden-click-hint" id="click-hint">
            Click anywhere<br />to plant your<br />flower ♡
          </div>

          <!-- Drag hint -->
          <div class="garden-drag-hint">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path
                d="M9 4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v5h3a2 2 0 0 1 2 2v2l-4 6H8l-4-6v-2a2 2 0 0 1 2-2h3V4Z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"></path>
            </svg>
            Drag to explore the garden ♡
          </div>

          <!-- Demo visitor flowers will be injected by JS -->
          <div id="flowers-container" style="pointer-events:none;"></div>
        </div>

        <!-- Form Panel -->
        <div class="form-panel anim-4">
          <p class="form-panel-title">
            <span class="deco-arrow">→</span>
            Your Bloom Story
