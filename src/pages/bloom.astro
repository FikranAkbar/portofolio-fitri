                    opacity="0.8"
                    transform="rotate(270)"></path>
                  <path
                    d="M0,2 C-6,1 -12,-6 -6,-13 C-3,-16 3,-16 6,-13 C12,-6 6,1 0,2 Z"
                    fill="#e090a8"
                    opacity="0.8"
                    transform="rotate(315)"></path>
                  <circle cx="0" cy="0" r="4.5" fill="#f0c038"></circle>
                  <circle cx="0" cy="0" r="2.8" fill="#e6a820"></circle>
                </g>
                <line
                  x1="24"
                  y1="40"
                  x2="24"
                  y2="26"
                  stroke="#6a8f45"
                  stroke-width="1.8"
                  stroke-linecap="round"></line>
              </svg>
            </div>
            <span class="pick-name">Cosmos</span>
          </button>

          <!-- Rose -->
          <button
            class="flower-pick-btn"
            data-flower="rose"
            style="--flower-color: #c04060; --flower-color-rgb: 192,64,96;"
          >
            <div class="pick-icon">
              <svg viewBox="0 0 48 48" width="44" height="44" fill="none">
                <g transform="translate(24,22)">
                  <path
                    d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z"
                    fill="#e06080"
                    opacity="0.55"
                    transform="rotate(0)"></path>
                  <path
                    d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z"
                    fill="#e06080"
                    opacity="0.55"
                    transform="rotate(72)"></path>
                  <path
                    d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z"
                    fill="#e06080"
                    opacity="0.55"
                    transform="rotate(144)"></path>
                  <path
                    d="M0,2 C-7,0 -9,-9 -4,-14 C-2,-16 2,-16 4,-14 C9,-9 7,0 0,2 Z"
