---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/sidebar/Sidebar.astro';
import CanvasPanel from '../components/canvas/CanvasPanel.astro';
---

<BaseLayout
  title="Fitri Zahwa — Portfolio"
  description="UI/UX Designer, Illustrator & Pixel Artist based in Indonesia"
>
  <!--
    Full-viewport two-column layout:
      left  → fixed-width sidebar (300px)
      right → flexible canvas panel
  -->
  <div class="flex h-screen w-full overflow-hidden bg-[#F5F5F5]">
    <!-- 24px spacing on left / top / bottom for the floating card -->
    <div class="pl-6 pt-6 pb-6 shrink-0 flex">
      <Sidebar />
    </div>
    <CanvasPanel />
  </div>
</BaseLayout>

