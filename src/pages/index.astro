---
import ForceGraph from '../components/ForceGraph.astro';

const nodes = [
  { id: "about",        label: "About Me"    },
  { id: "skills",       label: "Skills"      },
  { id: "projects",     label: "Projects"    },
  { id: "experience",   label: "Experience"  },
  { id: "education",    label: "Education"   },
  { id: "contact",      label: "Contact"     },
  { id: "blog",         label: "Blog"        },
  { id: "design",       label: "Design"      },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fitri — Portfolio</title>
    <meta name="description" content="Interactive portfolio of Fitri" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg:      #f8fafc;
        --surface: #ffffff;
        --text:    #1e293b;
        --muted:   #64748b;
        --border:  #e2e8f0;
      }

      html, body {
        height: 100%;
        font-family: 'Inter', system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      body {
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: 100vh;
      }

      /* ── Header ── */
      header {
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--surface);
      }

      header .logo {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--text);
        text-decoration: none;
      }

      header nav {
        display: flex;
        gap: 1.5rem;
      }

      header nav a {
        font-size: 0.875rem;
        color: var(--muted);
        text-decoration: none;
        transition: color 0.18s;
      }

      header nav a:hover { color: var(--text); }

      /* ── Main graph area ── */
      main {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem 1.5rem;
        gap: 0.75rem;
      }

      .graph-hint {
        font-size: 0.78rem;
        color: var(--muted);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        opacity: 0.75;
        user-select: none;
      }

      .graph-container {
        width: 100%;
        max-width: 1200px;
        height: clamp(520px, 75vh, 800px);
        border: 1px solid var(--border);
        border-radius: 20px;
        background: var(--surface);
        box-shadow: 0 4px 24px rgba(0,0,0,0.05);
        overflow: hidden;
      }

      /* ── Footer ── */
      footer {
        text-align: center;
        padding: 1.2rem;
        font-size: 0.8rem;
        color: var(--muted);
        border-top: 1px solid var(--border);
      }
    </style>
  </head>
  <body>
    <header>
      <a class="logo" href="/">fitri.</a>
      <nav>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <p class="graph-hint">drag the center node to explore</p>
      <div class="graph-container">
        <ForceGraph centerLabel="Fitri" nodes={nodes} />
      </div>
    </main>

    <footer>
      &copy; {new Date().getFullYear()} Fitri. All rights reserved.
    </footer>
  </body>
</html>

