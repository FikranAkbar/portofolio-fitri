---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome — Fitri Zahwa</title>
    <meta name="description" content="UI/UX Designer, Illustrator & Pixel Artist based in Indonesia" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,700&family=Source+Code+Pro:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        cursor: none !important;
      }

      html, body {
        height: 100%;
        font-family: 'Inter', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow: hidden;
        /* Bright, airy background */
        background: #F7F4FF;
      }

      /* ── Cursor: ring (dark) + dot ── */
      #cursor-ring {
        width: 28px;
        height: 28px;
        border: 1.5px solid rgba(90, 50, 160, 0.55);
        border-radius: 50%;
        pointer-events: none;
        position: fixed;
        transform: translate(-50%, -50%);
        z-index: 9999;
        transition: width 0.2s ease, height 0.2s ease, border-color 0.2s ease;
      }

      #cursor-dot {
        width: 5px;
        height: 5px;
        background: #7c3aed;
        border-radius: 50%;
        pointer-events: none;
        position: fixed;
        transform: translate(-50%, -50%);
        z-index: 9999;
        box-shadow: 0 0 6px 2px rgba(231, 58, 164, 0.5);
      }

      body:has(a:hover) #cursor-ring,
      body:has(button:hover) #cursor-ring {
        width: 42px;
        height: 42px;
        border-color: rgba(231, 58, 164, 0.85);
      }

      #starfield {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
      }

      /* ── Soft pastel blobs in background ── */
      .blob {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
      }

      /* ── Enter animations ── */
      @keyframes fade-up {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
      }
      @keyframes line-draw {
        from { transform: scaleX(0); }
        to   { transform: scaleX(1); }
      }
      @keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position: 200% center; }
      }
      @keyframes page-out {
        from { opacity: 1; transform: scale(1); }
        to   { opacity: 0; transform: scale(1.04); }
      }
      @keyframes orbit-pulse {
        0%, 100% { opacity: 0.25; }
        50%       { opacity: 0.5; }
      }

      .anim-welcome  { opacity: 0; animation: fade-up 0.9s cubic-bezier(0.22,1,0.36,1) 0.4s  forwards; }
      .anim-title    { opacity: 0; animation: fade-up 1.0s cubic-bezier(0.22,1,0.36,1) 0.7s  forwards; }
      .anim-divider  { opacity: 0; transform-origin: center; animation: line-draw 0.9s cubic-bezier(0.22,1,0.36,1) 1.15s forwards, fade-in 0.1s 1.15s forwards; }
      .anim-subtitle { opacity: 0; animation: fade-up 0.9s cubic-bezier(0.22,1,0.36,1) 1.4s  forwards; }
      .anim-btn      { opacity: 0; animation: fade-up 0.9s cubic-bezier(0.22,1,0.36,1) 1.75s forwards; }
      .anim-skip     { opacity: 0; animation: fade-in 0.8s ease 2.1s forwards; }
      .anim-footer   { opacity: 0; animation: fade-in 0.8s ease 2.2s forwards; }

      /* Dark-toned gradient for title against light bg */
      .title-gradient {
        background: linear-gradient(120deg, #4c1d95 0%, #7c3aed 25%, #db2777 55%, #9333ea 80%, #3730a3 100%);
        background-size: 220% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 6s linear 1.5s infinite;
      }

      /* ── Journey button (dark outlined) ── */
      .btn-journey {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 34px;
        border: 1.5px solid rgba(124, 58, 237, 0.45);
        border-radius: 100px;
        background: rgba(124, 58, 237, 0.06);
        color: #2e0a52;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.02em;
        transition: all 0.35s cubic-bezier(0.22,1,0.36,1);
        backdrop-filter: blur(8px);
        text-decoration: none;
        overflow: hidden;
      }

      .btn-journey::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(124,58,237,0.12), rgba(219,39,119,0.08));
        opacity: 0;
        transition: opacity 0.35s ease;
        border-radius: inherit;
      }

      .btn-journey:hover {
        border-color: rgba(219, 39, 119, 0.7);
        color: #5b1a8a;
        transform: translateY(-3px);
        box-shadow: 0 8px 28px rgba(124,58,237,0.18), 0 0 40px rgba(219,39,119,0.1);
      }

      .btn-journey:hover::after { opacity: 1; }

      .btn-journey .arrow {
        transition: transform 0.3s cubic-bezier(0.22,1,0.36,1);
        display: inline-block;
        position: relative; z-index: 1;
      }
      .btn-journey span { position: relative; z-index: 1; }
      .btn-journey:hover .arrow { transform: translateX(5px); }

      /* ── Skip button ── */
      .btn-skip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        color: rgba(15,5,40,0.4);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        transition: color 0.25s ease;
        background: transparent;
        border: none;
        font-family: 'Source Code Pro', monospace;
      }
      .btn-skip:hover { color: rgba(15,5,40,0.85); }

      /* ── Orbit rings styled for light bg ── */
      .orbit-ring {
        position: fixed;
        border-radius: 50%;
        border: 1px solid rgba(124,58,237,0.1);
        pointer-events: none;
        animation: orbit-pulse 6s ease-in-out infinite;
      }

      .page-exit { animation: page-out 0.55s cubic-bezier(0.4,0,1,1) forwards; }

      /* ══════════════════════════════════════
         VISITOR CARD OVERLAY
      ══════════════════════════════════════ */

      @keyframes ov-fade-in  { from { opacity:0 } to { opacity:1 } }
      @keyframes ov-slide-up { from { opacity:0; transform:translateY(36px) } to { opacity:1; transform:translateY(0) } }
      @keyframes ov-scale-in { from { opacity:0; transform:translateY(24px) scale(0.96) } to { opacity:1; transform:translateY(0) scale(1) } }
      @keyframes card-name-pop { 0%,100%{transform:scale(1)} 50%{transform:scale(0.97)} }

      #card-overlay {
        position: fixed;
        inset: 0;
        z-index: 200;
        background: #ECEAE4;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 32px 24px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.28s ease-out;
        overflow-y: auto;
      }
      #card-overlay.ov-visible {
        opacity: 1;
        pointer-events: all;
      }
      #card-overlay.ov-visible .ov-header   { animation: ov-slide-up 0.55s cubic-bezier(0.22,1,0.36,1) 0.08s both; }
      #card-overlay.ov-visible .ov-name-row { animation: ov-slide-up 0.55s cubic-bezier(0.22,1,0.36,1) 0.16s both; }
      #card-overlay.ov-visible #visitor-card { animation: ov-scale-in 0.6s cubic-bezier(0.22,1,0.36,1) 0.20s both; }
      #card-overlay.ov-visible .ov-colors   { animation: ov-slide-up 0.5s cubic-bezier(0.22,1,0.36,1) 0.32s both; }
      #card-overlay.ov-visible #btn-enter   { animation: ov-slide-up 0.5s cubic-bezier(0.22,1,0.36,1) 0.40s both; }
      #card-overlay.ov-visible .ov-fine-print { animation: ov-fade-in 0.5s ease 0.52s both; }

      #overlay-close {
        position: absolute;
        top: 26px;
        left: 30px;
        font-family: 'Source Code Pro', monospace;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(42,26,14,0.4);
        background: transparent;
        border: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: color 0.2s ease;
      }
      #overlay-close:hover { color: rgba(42,26,14,0.85); }

      .ov-header {
        text-align: center;
        margin-bottom: 28px;
      }
      .ov-header p {
        font-family: 'Source Code Pro', monospace;
        font-size: clamp(11px, 1.1vw, 13px);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(42,26,14,0.55);
        line-height: 1.8;
        margin: 0;
      }

      .ov-name-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
        width: 100%;
        max-width: 420px;
      }
      .ov-name-label {
        font-family: 'Source Code Pro', monospace;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(42,26,14,0.65);
        white-space: nowrap;
        font-weight: 500;
      }
      .ov-name-input {
        flex: 1;
        font-family: 'Source Code Pro', monospace;
        font-size: 13px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #2a1a0e;
        background: #fff;
        border: 1px solid rgba(42,26,14,0.12);
        border-radius: 8px;
        padding: 10px 14px;
        outline: none;
        transition: border-color 0.2s ease;
      }
      .ov-name-input:focus { border-color: rgba(42,26,14,0.4); }
      .ov-name-input::placeholder { color: rgba(42,26,14,0.25); }

      .ov-randomize {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid rgba(42,26,14,0.15);
        background: rgba(42,26,14,0.06);
        color: rgba(42,26,14,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        transition: all 0.2s ease;
        flex-shrink: 0;
      }
      .ov-randomize:hover { background: rgba(42,26,14,0.12); color: #2a1a0e; }

      /* ── Visitor Card ── */
      #visitor-card {
        width: 340px;
        height: 213px;
        border-radius: 14px;
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 18px 50px rgba(0,0,0,0.22), 0 6px 18px rgba(0,0,0,0.12);
        flex-shrink: 0;
        transition: transform 0.3s cubic-bezier(0.22,1,0.36,1);
        color: #e4f0e8;
      }
      #visitor-card:hover { transform: translateY(-4px) scale(1.01); }

      #visitor-card.card-blue   { background: linear-gradient(135deg, #1e3a5f 0%, #2d5986 100%); color:#e8f0f8; }
      #visitor-card.card-green  { background: linear-gradient(135deg, #1a3a2a 0%, #2d6645 100%); color:#e4f0e8; }
      #visitor-card.card-rose   { background: linear-gradient(135deg, #4a1428 0%, #8b2252 100%); color:#f5e4ea; }
      #visitor-card.card-amber  { background: linear-gradient(135deg, #3d2200 0%, #7a4a10 100%); color:#f5ead8; }

      .card-inner {
        position: absolute;
        inset: 0;
        padding: 20px 22px 18px;
        display: flex;
        flex-direction: column;
        z-index: 2;
      }
      .card-title-text {
        font-family: 'DM Sans', Inter, sans-serif;
        font-size: 17px;
        font-weight: 700;
        font-style: italic;
        letter-spacing: -0.01em;
        color: inherit;
        margin-bottom: auto;
      }
      .card-mid {
        margin-bottom: 14px;
      }
      .card-visitor-label {
        display: block;
        font-family: 'Source Code Pro', monospace;
        font-size: 8px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: inherit;
        opacity: 0.65;
        margin-bottom: 4px;
      }
      .card-visitor-name {
        display: block;
        font-family: 'Source Code Pro', monospace;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: inherit;
        max-width: 170px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .card-bottom-row {
        display: flex;
        align-items: flex-end;
        gap: 20px;
      }
      .card-meta-item {
        display: flex;
        flex-direction: column;
        gap: 3px;
      }
      .card-meta-label {
        font-family: 'Source Code Pro', monospace;
        font-size: 7px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: inherit;
        opacity: 0.65;
      }
      .card-meta-val {
        font-family: 'Source Code Pro', monospace;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.08em;
        color: inherit;
      }
      .card-sig-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-left: auto;
        padding-bottom: 2px;
      }
      .card-sig-x {
        font-family: 'Source Code Pro', monospace;
        font-size: 11px;
        color: inherit;
        opacity: 0.6;
      }
      .card-sig-line {
        width: 60px;
        height: 0;
        border-bottom: 1px solid currentColor;
        opacity: 0.35;
      }

      /* Decorative SVG */
      .card-decor {
        position: absolute;
        right: -8px;
        top: -8px;
        bottom: -8px;
        width: 140px;
        opacity: 0.15;
        pointer-events: none;
        z-index: 1;
        display: flex;
        align-items: center;
      }
      .card-decor svg {
        width: 100%;
        height: 100%;
        color: currentColor;
      }

      /* ── Color swatches ── */
      .ov-colors {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 28px;
      }
      .color-swatch {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: 2px solid transparent;
        outline: none;
        transition: all 0.2s ease;
        flex-shrink: 0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      }
      .color-swatch.active {
        outline: 2.5px solid rgba(42,26,14,0.7);
        outline-offset: 2.5px;
      }
      .color-swatch[data-color="blue"]  { background: #2d5986; }
      .color-swatch[data-color="green"] { background: #2d6645; }
      .color-swatch[data-color="rose"]  { background: #8b2252; }
      .color-swatch[data-color="amber"] { background: #7a4a10; }

      .icon-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid rgba(42,26,14,0.18);
        background: rgba(42,26,14,0.05);
        color: rgba(42,26,14,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
      }
      .icon-btn:hover { background: rgba(42,26,14,0.12); color: #2a1a0e; }
      .icon-btn.active { background: rgba(42,26,14,0.14); color: #2a1a0e; border-color: rgba(42,26,14,0.35); }

      /* ── Enter button ── */
      #btn-enter {
        background: #1a0e08;
        color: #ECEAE4;
        border: none;
        border-radius: 100px;
        padding: 13px 48px;
        font-family: 'Source Code Pro', monospace;
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-bottom: 14px;
        transition: all 0.25s ease;
        box-shadow: 0 6px 20px rgba(0,0,0,0.2);
      }
      #btn-enter:hover {
        background: #2a1a0e;
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(0,0,0,0.28);
      }
      #btn-enter:active { transform: translateY(0); }

      .ov-fine-print {
        font-family: 'Source Code Pro', monospace;
        font-size: 10px;
        letter-spacing: 0.06em;
        color: rgba(42,26,14,0.38);
        font-style: italic;
        text-align: center;
      }
    </style>
  </head>

  <body class="h-full">

    <!-- Cursor -->
    <div id="cursor-ring"></div>
    <div id="cursor-dot"></div>

    <!-- Star/particle canvas -->
    <canvas id="starfield"></canvas>

    <!-- Soft light blobs for background depth -->
    <div class="blob" style="width:900px;height:900px;background:radial-gradient(circle,rgba(196,181,253,0.6) 0%,transparent 65%);filter:blur(80px);bottom:-300px;left:-250px;"></div>
    <div class="blob" style="width:700px;height:700px;background:radial-gradient(circle,rgba(251,207,232,0.6) 0%,transparent 65%);filter:blur(80px);top:-200px;right:-150px;"></div>
    <div class="blob" style="width:500px;height:500px;background:radial-gradient(circle,rgba(165,180,252,0.5) 0%,transparent 65%);filter:blur(70px);top:35%;right:10%;"></div>
    <div class="blob" style="width:400px;height:400px;background:radial-gradient(circle,rgba(233,213,255,0.65) 0%,transparent 65%);filter:blur(60px);bottom:5%;left:30%;"></div>

    <!-- Decorative orbit rings -->
    <div class="orbit-ring" style="width:500px;height:500px;top:50%;left:50%;margin-top:-250px;margin-left:-250px;animation-delay:0s;"></div>
    <div class="orbit-ring" style="width:760px;height:760px;top:50%;left:50%;margin-top:-380px;margin-left:-380px;animation-delay:2.5s;border-color:rgba(219,39,119,0.07);"></div>

    <!-- SKIP INTRO -->
    <div style="position:fixed;top:28px;right:32px;z-index:100;" class="anim-skip">
      <button class="btn-skip" id="btn-skip">
        SKIP INTRO
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <!-- Wordmark -->
    <div style="position:fixed;top:30px;left:36px;z-index:100;" class="anim-skip">
      <span style="font-family:'Source Code Pro',monospace;font-size:11px;letter-spacing:0.14em;color:rgba(15,5,40,0.3);text-transform:uppercase;">fitri.world</span>
    </div>

    <!-- Main content — centered -->
    <main style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 10vw;text-align:center;">
      <div style="max-width:800px;width:100%;display:flex;flex-direction:column;align-items:center;">

        <!-- WELCOME TO label -->
        <div class="anim-welcome" style="margin-bottom:14px;display:flex;align-items:center;gap:12px;">
          <div style="width:28px;height:1px;background:rgba(219,39,119,0.6);"></div>
          <span style="font-family:'Source Code Pro',monospace;font-size:11px;letter-spacing:0.26em;color:rgba(219,39,119,0.85);text-transform:uppercase;font-weight:500;">Welcome to</span>
          <div style="width:28px;height:1px;background:rgba(219,39,119,0.6);"></div>
        </div>

        <!-- Title -->
        <h1 class="anim-title" style="font-family:'DM Sans',Inter,sans-serif;font-size:clamp(54px,8.5vw,100px);font-weight:700;line-height:1.0;letter-spacing:-0.025em;margin-bottom:32px;">
          <span style="display:block;color:#0d0520;">Fitri's</span>
          <span class="title-gradient" style="display:block;font-style:italic;">World</span>
        </h1>

        <!-- Divider -->
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:32px;width:100%;max-width:460px;justify-content:center;">
          <div class="anim-divider" style="height:1px;flex:1;background:linear-gradient(to right,rgba(255,255,255,0),rgba(124,58,237,0.5));transform-origin:right;"></div>
          <div class="anim-welcome" style="width:5px;height:5px;border-radius:50%;background:#9333ea;flex-shrink:0;box-shadow:0 0 8px rgba(147,51,234,0.6);"></div>
          <div class="anim-divider" style="height:1px;flex:1;background:linear-gradient(to left,rgba(255,255,255,0),rgba(219,39,119,0.4));transform-origin:left;"></div>
        </div>

        <!-- Subtitle -->
        <p class="anim-subtitle" style="font-family:'Inter',sans-serif;font-size:clamp(14px,1.35vw,17px);font-weight:400;line-height:1.85;color:rgba(15,5,40,0.58);max-width:480px;margin-bottom:60px;letter-spacing:0.01em;">
          There are stories waiting to be shaped,<br />
          why not begin with mine and build something together?
        </p>

        <!-- CTA -->
        <div class="anim-btn">
          <a href="/home" class="btn-journey" id="btn-journey">
            <span>Start the Journey</span>
            <span class="arrow">→</span>
          </a>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <div class="anim-footer" style="position:fixed;bottom:28px;left:0;right:0;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:0 36px;">
      <span style="font-family:'Source Code Pro',monospace;font-size:10px;letter-spacing:0.1em;color:rgba(15,5,40,0.3);text-transform:uppercase;">© 2025 Fitri Zahwa</span>
      <span style="font-family:'Source Code Pro',monospace;font-size:10px;letter-spacing:0.1em;color:rgba(15,5,40,0.3);text-transform:uppercase;">UI/UX · Illustration · Pixel Art</span>
    </div>

    <script>
      // ── Cursor
      const ring = document.getElementById('cursor-ring') as HTMLElement;
      const dot  = document.getElementById('cursor-dot')  as HTMLElement;
      let mx = -100, my = -100, rx = -100, ry = -100;

      document.addEventListener('mousemove', (e) => {
        mx = e.clientX; my = e.clientY;
        dot.style.left = mx + 'px';
        dot.style.top  = my + 'px';
      });

      (function animRing() {
        rx += (mx - rx) * 0.12;
        ry += (my - ry) * 0.12;
        ring.style.left = rx + 'px';
        ring.style.top  = ry + 'px';
        requestAnimationFrame(animRing);
      })();

      // ── Canvas: Milky Way + dark particles
      const canvas = document.getElementById('starfield') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;

      function resize() {
        canvas.width  = window.innerWidth;
        canvas.height = window.innerHeight;
        // aurora redraws dynamically each frame — nothing to reset here
      }

      // ─── Aurora orbs — animated soft nebula glows
      interface AuroraOrb {
        x: number; y: number;
        rx: number; ry: number;
        color: string;
        baseAlpha: number;
        phase: number; speed: number;
        driftX: number; driftY: number;
      }

      const auroraOrbs: AuroraOrb[] = [
        { x: 0.18, y: 0.28, rx: 0.38, ry: 0.25, color: '180,130,255', baseAlpha: 0.10, phase: 0,    speed: 0.0007, driftX: 0.00008, driftY: 0.00004 },
        { x: 0.75, y: 0.18, rx: 0.32, ry: 0.20, color: '240,150,200', baseAlpha: 0.09, phase: 1.8,  speed: 0.0009, driftX:-0.00006, driftY: 0.00005 },
        { x: 0.55, y: 0.72, rx: 0.36, ry: 0.22, color: '150,100,240', baseAlpha: 0.08, phase: 3.5,  speed: 0.0006, driftX: 0.00005, driftY:-0.00003 },
        { x: 0.88, y: 0.60, rx: 0.28, ry: 0.18, color: '220,120,255', baseAlpha: 0.08, phase: 0.9,  speed: 0.0011, driftX:-0.00007, driftY:-0.00004 },
        { x: 0.08, y: 0.70, rx: 0.30, ry: 0.20, color: '170,100,220', baseAlpha: 0.07, phase: 2.4,  speed: 0.0008, driftX: 0.00006, driftY: 0.00006 },
        { x: 0.45, y: 0.10, rx: 0.30, ry: 0.16, color: '210,160,255', baseAlpha: 0.07, phase: 4.2,  speed: 0.0010, driftX:-0.00005, driftY: 0.00005 },
      ];

      // Track accumulated drift
      const orbOffsets = auroraOrbs.map(() => ({ ox: 0, oy: 0 }));

      function drawAurora(t: number) {
        for (let i = 0; i < auroraOrbs.length; i++) {
          const o = auroraOrbs[i];
          const off = orbOffsets[i];

          // Slow drift
          off.ox += o.driftX;
          off.oy += o.driftY;
          // Gentle sine wander
          const wx = Math.sin(t * o.speed * 0.7 + o.phase) * 0.04;
          const wy = Math.cos(t * o.speed * 0.5 + o.phase + 1) * 0.03;

          const cx = (o.x + off.ox + wx) * canvas.width;
          const cy = (o.y + off.oy + wy) * canvas.height;
          const rw = o.rx * canvas.width;
          const rh = o.ry * canvas.height;

          // Breathe alpha
          const breathe = Math.sin(t * o.speed + o.phase) * 0.35 + 0.65;
          const alpha = o.baseAlpha * breathe;

          // Elliptical radial gradient using scale trick
          ctx.save();
          ctx.translate(cx, cy);
          ctx.scale(1, rh / rw);
          const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, rw);
          grad.addColorStop(0,    `rgba(${o.color},${alpha})`);
          grad.addColorStop(0.45, `rgba(${o.color},${alpha * 0.55})`);
          grad.addColorStop(1,    `rgba(${o.color},0)`);
          ctx.beginPath();
          ctx.arc(0, 0, rw, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();
          ctx.restore();
        }
      }

      resize();
      window.addEventListener('resize', resize);

      // ─── Floating dark particles
      interface Particle {
        x: number; y: number;
        vx: number; vy: number;
        r: number;
        alpha: number; targetAlpha: number;
        color: string;
        twinkleSpeed: number; twinkleOffset: number;
      }

      const PARTICLE_COLORS = [
        '60,20,100',   // deep violet
        '90,30,130',   // purple
        '130,30,80',   // dark rose
        '50,40,120',   // indigo
        '100,20,60',   // dark pink
        '70,50,150',   // periwinkle dark
        '160,60,100',  // mauve
      ];

      const PARTICLE_COUNT = 220;

      function mkParticle(): Particle {
        const col = PARTICLE_COLORS[Math.floor(Math.random() * PARTICLE_COLORS.length)];
        return {
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 0.18,
          vy: (Math.random() - 0.5) * 0.18,
          r:  Math.random() * 1.6 + 0.3,
          alpha: 0,
          targetAlpha: Math.random() * 0.55 + 0.15,
          color: col,
          twinkleSpeed:  Math.random() * 0.015 + 0.004,
          twinkleOffset: Math.random() * Math.PI * 2,
        };
      }

      let particles: Particle[] = Array.from({ length: PARTICLE_COUNT }, mkParticle);
      let t = 0;

      // ─── Shooting stars (dark streaks)
      interface Shoot {
        x: number; y: number;
        vx: number; vy: number;
        len: number; life: number; maxLife: number;
        color: string;
      }
      let shoots: Shoot[] = [];

      function spawnShoot() {
        const angle = (Math.random() * 35 + 10) * (Math.PI / 180);
        const speed = Math.random() * 6 + 8;
        const shootColors = ['60,20,100', '90,30,130', '130,30,80', '70,50,150'];
        const c = shootColors[Math.floor(Math.random() * shootColors.length)];
        shoots.push({
          x: Math.random() * canvas.width * 0.75,
          y: Math.random() * canvas.height * 0.5,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          len: Math.random() * 100 + 70,
          life: 0,
          maxLife: Math.random() * 35 + 25,
          color: c,
        });
      }

      setInterval(spawnShoot, 3500);
      setTimeout(spawnShoot, 2000);

      function drawFrame() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        t++;

        // Draw aurora nebula orbs
        drawAurora(t);

        // Draw + update particles
        for (const p of particles) {
          // fade in
          p.alpha += (p.targetAlpha - p.alpha) * 0.02;

          // twinkle
          const tw = Math.sin(t * p.twinkleSpeed + p.twinkleOffset) * 0.25 + 0.75;
          const a  = p.alpha * tw;

          p.x += p.vx;
          p.y += p.vy;

          // wrap around
          if (p.x < -5) p.x = canvas.width + 5;
          if (p.x > canvas.width + 5) p.x = -5;
          if (p.y < -5) p.y = canvas.height + 5;
          if (p.y > canvas.height + 5) p.y = -5;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${p.color},${a})`;
          ctx.fill();

          // subtle glow for larger particles
          if (p.r > 1.0 && a > 0.3) {
            const grd = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 3.5);
            grd.addColorStop(0, `rgba(${p.color},${a * 0.25})`);
            grd.addColorStop(1, `rgba(${p.color},0)`);
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r * 3.5, 0, Math.PI * 2);
            ctx.fillStyle = grd;
            ctx.fill();
          }
        }

        // Draw shooting stars
        for (let i = shoots.length - 1; i >= 0; i--) {
          const s = shoots[i];
          s.life++;
          const prog  = s.life / s.maxLife;
          const alpha = prog < 0.25 ? prog / 0.25 : prog > 0.65 ? 1 - (prog - 0.65) / 0.35 : 1;

          const mag  = Math.hypot(s.vx, s.vy);
          const tailX = s.x - (s.vx / mag) * s.len;
          const tailY = s.y - (s.vy / mag) * s.len;

          const grad = ctx.createLinearGradient(tailX, tailY, s.x, s.y);
          grad.addColorStop(0, `rgba(${s.color},0)`);
          grad.addColorStop(1, `rgba(${s.color},${alpha * 0.75})`);

          ctx.beginPath();
          ctx.moveTo(tailX, tailY);
          ctx.lineTo(s.x, s.y);
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.2;
          ctx.lineCap = 'round';
          ctx.stroke();

          // head
          const hg = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, 5);
          hg.addColorStop(0, `rgba(${s.color},${alpha * 0.85})`);
          hg.addColorStop(1, `rgba(${s.color},0)`);
          ctx.beginPath();
          ctx.arc(s.x, s.y, 5, 0, Math.PI * 2);
          ctx.fillStyle = hg;
          ctx.fill();

          s.x += s.vx;
          s.y += s.vy;
          if (s.life >= s.maxLife) shoots.splice(i, 1);
        }

        requestAnimationFrame(drawFrame);
      }

      drawFrame();

      // ── Navigate
      function navigateTo(href: string) {
        sessionStorage.setItem('introSeen', '1');
        document.body.style.pointerEvents = 'none';
        document.body.classList.add('page-exit');
        setTimeout(() => { window.location.href = href; }, 520);
      }

      document.getElementById('btn-skip')?.addEventListener('click', () => {
        navigateTo('/home');
      });

      // ══════════════════════════════════════
      //  VISITOR CARD OVERLAY
      // ══════════════════════════════════════

      const RANDOM_NAMES = [
        'VIOLET DREAMER', 'SILVER WANDERER', 'GOLDEN REVERIE', 'INDIGO MOTH',
        'BLOOM SEEKER', 'HOLLOW ECHO', 'EMBER GHOST', 'PEARL DRIFTER',
        'COBALT REVERIE', 'SAGE WANDERER', 'COPPER SIGNAL', 'ASHEN LULLABY',
        'IVORY PILGRIM', 'TIDAL MUSE', 'CRIMSON PHANTOM', 'DUSK COLLECTOR',
        'FERN ORACLE', 'MIST WEAVER', 'ONYX ATLAS', 'VELVET NOMAD',
        'PRISM KEEPER', 'SABLE HORIZON', 'OPAL CURRENT', 'LUNAR CARTOGRAPHER',
      ];

      function pickRandom<T>(arr: T[]): T {
        return arr[Math.floor(Math.random() * arr.length)];
      }

      function formatIssueDate(): string {
        const d = new Date();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const yy = String(d.getFullYear()).slice(2);
        return `${mm}/${dd}/${yy}`;
      }

      const cardState = {
        name:       pickRandom(RANDOM_NAMES),
        color:      'green',
        cardNumber: String(Math.floor(1000 + Math.random() * 9000)),
        issueDate:  formatIssueDate(),
        showPattern: true,
      };

      function updateCardPreview() {
        const card = document.getElementById('visitor-card') as HTMLElement;
        const nameEl = document.getElementById('card-name-display') as HTMLElement;
        const dateEl = document.getElementById('card-date-display') as HTMLElement;
        const numEl  = document.getElementById('card-number-display') as HTMLElement;

        // Swap color class
        card.className = `card-${cardState.color}`;
        nameEl.textContent = cardState.name || 'VISITOR';
        dateEl.textContent = cardState.issueDate;
        numEl.textContent  = cardState.cardNumber;

        // Pattern visibility
        const decor = card.querySelector('.card-decor') as HTMLElement;
        if (decor) decor.style.opacity = cardState.showPattern ? '0.15' : '0';

        // Animate name pop
        nameEl.style.animation = 'none';
        // Force reflow
        void nameEl.offsetWidth;
        nameEl.style.animation = 'card-name-pop 150ms ease-in-out';
      }

      function openOverlay() {
        const overlay = document.getElementById('card-overlay') as HTMLElement;
        const input   = document.getElementById('name-input') as HTMLInputElement;
        input.value   = cardState.name;
        updateCardPreview();
        overlay.classList.add('ov-visible');
      }

      function closeOverlay() {
        const overlay = document.getElementById('card-overlay') as HTMLElement;
        overlay.classList.remove('ov-visible');
      }

      // Override btn-journey to open overlay
      document.getElementById('btn-journey')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openOverlay();
      }, { capture: true });

      document.getElementById('overlay-close')?.addEventListener('click', closeOverlay);

      document.getElementById('btn-randomize')?.addEventListener('click', () => {
        cardState.name = pickRandom(RANDOM_NAMES);
        (document.getElementById('name-input') as HTMLInputElement).value = cardState.name;
        updateCardPreview();
      });

      document.getElementById('name-input')?.addEventListener('input', (e) => {
        cardState.name = (e.target as HTMLInputElement).value.toUpperCase();
        updateCardPreview();
      });

      document.querySelectorAll('.color-swatch').forEach((btn) => {
        btn.addEventListener('click', () => {
          cardState.color = (btn as HTMLElement).dataset.color ?? 'green';
          document.querySelectorAll('.color-swatch').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          updateCardPreview();
        });
      });

      document.getElementById('btn-pattern-toggle')?.addEventListener('click', (e) => {
        cardState.showPattern = !cardState.showPattern;
        (e.currentTarget as HTMLElement).classList.toggle('active', cardState.showPattern);
        updateCardPreview();
      });

      document.getElementById('btn-clear-name')?.addEventListener('click', () => {
        cardState.name = '';
        (document.getElementById('name-input') as HTMLInputElement).value = '';
        updateCardPreview();
      });

      document.getElementById('btn-enter')?.addEventListener('click', () => {
        sessionStorage.setItem('visitorCard', JSON.stringify({
          name:       cardState.name,
          color:      cardState.color,
          cardNumber: cardState.cardNumber,
          issueDate:  cardState.issueDate,
        }));
        navigateTo('/home');
      });
    </script>

    <!-- ══ Visitor Card Overlay ══ -->
    <div id="card-overlay">

      <button id="overlay-close">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M9 7H3M5 4l-3 3 3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        BACK
      </button>

      <div class="ov-header">
        <p>WELCOME, VISITOR.</p>
        <p style="opacity:0.5;">I HOPE YOU ENJOY YOUR TIME HERE.</p>
      </div>

      <div class="ov-name-row">
        <span class="ov-name-label">NAME:</span>
        <input id="name-input" class="ov-name-input" type="text" maxlength="32" placeholder="YOUR NAME" autocomplete="off" />
        <button id="btn-randomize" class="ov-randomize" title="Random name">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
            <path d="M2 5a5 5 0 0 1 9.19-2M13 10a5 5 0 0 1-9.19 2M11 3l2 2-2 2M4 8l-2 2 2 2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <!-- Card Preview -->
      <div id="visitor-card" class="card-green">
        <div class="card-inner">
          <span class="card-title-text">Fitri's World</span>
          <div class="card-mid">
            <span class="card-visitor-label">VISITOR</span>
            <span id="card-name-display" class="card-visitor-name">VIOLET DREAMER</span>
          </div>
          <div class="card-bottom-row">
            <div class="card-meta-item">
              <span class="card-meta-label">ISSUED ON</span>
              <span id="card-date-display" class="card-meta-val">05/12/26</span>
            </div>
            <div class="card-meta-item">
              <span class="card-meta-label">NO.</span>
              <span id="card-number-display" class="card-meta-val">3382</span>
            </div>
            <div class="card-sig-row">
              <span class="card-sig-x">X</span>
              <div class="card-sig-line"></div>
            </div>
          </div>
        </div>
        <!-- Decorative floral SVG -->
        <div class="card-decor">
          <svg viewBox="0 0 130 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10,100 C10,40 50,10 90,30 C130,50 140,90 110,120 C80,150 40,140 30,110 C20,80 50,60 70,80 C90,100 85,130 65,135 C45,140 25,120 30,95" fill="none" stroke="currentColor" stroke-width="1.2"/>
            <path d="M90,30 C95,15 110,8 115,22 C120,36 108,48 95,42" fill="none" stroke="currentColor" stroke-width="1"/>
            <path d="M30,110 C15,115 8,130 20,138 C32,146 46,136 42,122" fill="none" stroke="currentColor" stroke-width="1"/>
            <path d="M70,80 C78,65 95,62 98,75 C101,88 88,96 78,90" fill="none" stroke="currentColor" stroke-width="0.9"/>
            <!-- Central bloom -->
            <ellipse cx="65" cy="72" rx="7" ry="16" fill="currentColor" opacity="0.55" transform="rotate(0 65 72)"/>
            <ellipse cx="65" cy="72" rx="7" ry="16" fill="currentColor" opacity="0.55" transform="rotate(45 65 72)"/>
            <ellipse cx="65" cy="72" rx="7" ry="16" fill="currentColor" opacity="0.55" transform="rotate(90 65 72)"/>
            <ellipse cx="65" cy="72" rx="7" ry="16" fill="currentColor" opacity="0.55" transform="rotate(135 65 72)"/>
            <circle cx="65" cy="72" r="5" fill="currentColor" opacity="0.85"/>
            <!-- Secondary buds -->
            <ellipse cx="95" cy="32" rx="5" ry="10" fill="currentColor" opacity="0.5" transform="rotate(25 95 32)"/>
            <ellipse cx="95" cy="32" rx="5" ry="10" fill="currentColor" opacity="0.5" transform="rotate(70 95 32)"/>
            <circle cx="95" cy="32" r="3.5" fill="currentColor" opacity="0.75"/>
            <ellipse cx="28" cy="118" rx="4" ry="9" fill="currentColor" opacity="0.45" transform="rotate(-20 28 118)"/>
            <ellipse cx="28" cy="118" rx="4" ry="9" fill="currentColor" opacity="0.45" transform="rotate(25 28 118)"/>
            <circle cx="28" cy="118" r="3" fill="currentColor" opacity="0.7"/>
            <!-- Leaf sprouts -->
            <path d="M40,55 C32,42 48,36 46,52" fill="currentColor" opacity="0.45"/>
            <path d="M86,118 C96,107 102,120 89,124" fill="currentColor" opacity="0.45"/>
            <path d="M22,88 C12,76 26,68 29,84" fill="currentColor" opacity="0.45"/>
            <path d="M112,108 C122,96 126,112 114,115" fill="currentColor" opacity="0.4"/>
            <!-- Dot accents -->
            <circle cx="55" cy="38" r="2" fill="currentColor" opacity="0.4"/>
            <circle cx="102" cy="100" r="1.5" fill="currentColor" opacity="0.35"/>
            <circle cx="18" cy="113" r="1.5" fill="currentColor" opacity="0.35"/>
            <circle cx="78" cy="145" r="1.8" fill="currentColor" opacity="0.3"/>
            <circle cx="48" cy="162" r="1.2" fill="currentColor" opacity="0.28"/>
            <circle cx="108" cy="55" r="1.5" fill="currentColor" opacity="0.32"/>
          </svg>
        </div>
      </div>

      <!-- Color & style controls -->
      <div class="ov-colors">
        <button class="color-swatch" data-color="blue"  title="Blue"></button>
        <button class="color-swatch active" data-color="green" title="Green"></button>
        <button class="color-swatch" data-color="rose"  title="Rose"></button>
        <button class="color-swatch" data-color="amber" title="Amber"></button>

        <!-- Pattern toggle -->
        <button class="icon-btn active" id="btn-pattern-toggle" title="Toggle pattern">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
            <path d="M3 7.5 C3 4.5 5 2.5 7.5 3 C10 3.5 11.5 5.5 10.5 8 C9.5 10.5 7 10.5 6 9 C5 7.5 6.5 6 7.5 7 C8.5 8 8 9.5 7 9.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
          </svg>
        </button>
        <!-- Clear name -->
        <button class="icon-btn" id="btn-clear-name" title="Clear name">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
            <path d="M9 3l3 3-6 6H3v-3L9 3z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <button id="btn-enter">ENTER →</button>

      <p class="ov-fine-print">Your card will appear in the visitor gallery after review.</p>

    </div>

  </body>
</html>
