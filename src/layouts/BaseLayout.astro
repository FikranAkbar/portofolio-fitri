---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fitri Zahwa — Portfolio',
  description = 'UI/UX Designer, Illustrator & Pixel Artist based in Indonesia',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=DM+Sans:wght@400;500;600;700&family=Source+Code+Pro:wght@400;500&family=Inconsolata:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="h-full bg-[#F5F5F5] text-gray-900 font-sans antialiased">
    <slot />
  </body>
</html>

